                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left Column: Gemini Models -->
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{DynamicResource Ag.GeminiModels}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Gemini 5H -->
                                                        <Grid Margin="0,0,0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource Ag.FiveHourLabel}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextDimBrush}"/>
                                                                <TextBlock Text="{Binding Quota5hCountdown}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Quota5hPercentText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource MiniQuotaProgress}" Value="{Binding Quota5hPercentValue, Mode=OneWay}" Margin="0,0,0,8"
                                                                     Foreground="{StaticResource GreenBrush}"/>

                                                        <!-- Gemini Weekly -->
                                                        <Grid Margin="0,0,0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource Ag.WeeklyLabel}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextDimBrush}"/>
                                                                <TextBlock Text="{Binding QuotaWeeklyCountdown}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding QuotaWeeklyPercentText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource MiniQuotaProgress}" Value="{Binding QuotaWeeklyPercentValue, Mode=OneWay}"
                                                                     Foreground="{StaticResource AccentBrush}"/>
                                                    </StackPanel>

                                                    <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0" HorizontalAlignment="Center"/>

                                                    <!-- Right Column: Claude & GPT Models -->
                                                    <StackPanel Grid.Column="2">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <Border Background="#F5F3FF" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{DynamicResource Ag.ClaudeGptModels}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Claude 5H -->
                                                        <Grid Margin="0,0,0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource Ag.FiveHourLabel}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextDimBrush}"/>
                                                                <TextBlock Text="{Binding Quota3p5hCountdown}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Quota3p5hPercentText}" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource MiniQuotaProgress}" Value="{Binding Quota3p5hPercentValue, Mode=OneWay}" Margin="0,0,0,8"
                                                                     Foreground="#10B981"/>

                                                        <!-- Claude Weekly -->
                                                        <Grid Margin="0,0,0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource Ag.WeeklyLabel}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextDimBrush}"/>
                                                                <TextBlock Text="{Binding Quota3pWeeklyCountdown}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Quota3pWeeklyPercentText}" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource MiniQuotaProgress}" Value="{Binding Quota3pWeeklyPercentValue, Mode=OneWay}"
                                                                     Foreground="#8B5CF6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardHoverBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActivating}" Value="True">
                                            <Setter TargetName="ActivateIcon" Property="Opacity" Value="0.6"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="ActivateSpin">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActivateIconRotate"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:0.8"
                                                                         RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="ActivateSpin"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActivating}" Value="False">
                                            <Setter TargetName="ActivateIcon" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardActiveBorderBrush}"/>
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActiveBrush}"/>
                                            <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="SwitchBtnCard" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <StackPanel x:Name="AgEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource IconUserPlus}" Fill="{StaticResource TextMutedBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Ag.EmptyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Ag.EmptyDesc}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{DynamicResource Ag.EmptyImport}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="OnImportFromAgTools"/>
                            <Button Content="{DynamicResource Ag.EmptyLogin}" Style="{StaticResource GhostButton}" Click="OnNewAccountLogin"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ==================== Codex ==================== -->
        <TabItem Tag="codex">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconOpenAi}" Fill="{StaticResource OpenAiBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Codex" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Main.TabCodexSub}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="28,14,28,24">
