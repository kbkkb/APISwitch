                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconZap}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Common.ApplyBtn}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="{DynamicResource Common.Edit}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCardEditDesktop"/>
                                                <Button Content="{DynamicResource Common.CopyCross}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCardCopyDesktop"/>
                                                <Button Content="{DynamicResource Common.Delete}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OnCardDeleteDesktop"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardHoverBrush}"/>
                                            <Setter TargetName="DragGrip" Property="Fill" Value="#94A3B8"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardActiveBorderBrush}"/>
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActiveBrush}"/>
                                            <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ApplyBtnCard" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
