                                        <Ellipse x:Name="CodexRouterDot" Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CodexRouterChipText" Text="{DynamicResource Router.DirectModeNoRouter}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

