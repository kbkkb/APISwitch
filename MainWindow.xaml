                    </ScrollViewer>
                    <StackPanel x:Name="OcEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextMutedBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Oc.EmptyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common.EmptyDesc}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <Button Content="{DynamicResource Common.EmptyAddBtn}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="OnAddOpencode"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ==================== Pi ==================== -->
        <TabItem Tag="pi">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPi}" Fill="#7C3AED" Width="15" Height="15" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Pi" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Main.TabPiSub}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="28,14,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Status Card -->
                <Border Grid.Row="0" Background="{DynamicResource HeroCardBgBrush}" BorderBrush="{DynamicResource HeroCardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="23" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPi}" Fill="#7C3AED" Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{DynamicResource Pi.HeroTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                             <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                 <Border Style="{StaticResource Chip}">
                                     <StackPanel Orientation="Horizontal">
                                         <TextBlock Text="{DynamicResource Common.PoolLabel}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                         <TextBlock x:Name="PiPoolCountText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                     </StackPanel>
                                 </Border>
                                 <Border Style="{StaticResource Chip}" Margin="8,0,0,0" ToolTip="{DynamicResource Pi.DefaultTip}">
                                     <StackPanel Orientation="Horizontal">
                                         <TextBlock Text="{DynamicResource Common.DefaultLabel}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                         <TextBlock x:Name="PiDefaultModelText" Text="{DynamicResource Common.NotSet}" FontSize="12" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                     </StackPanel>
                                 </Border>
                             </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                    <Button Style="{StaticResource PrimaryButton}" Click="OnAddPi">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.AddProvider}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnImportCc">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconImport}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.CcImport}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnRefreshPi">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.Refresh}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenPiModels">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExternal}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Pi.OpenModelsBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenPiDir">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Pi.OpenDirBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCapturePi">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSave}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Pi.CaptureBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Cards List -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnCardsPreviewMouseWheel">
                        <ListBox x:Name="PiList" Margin="0,4,0,0" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 PreviewMouseLeftButtonDown="OnCardListPreviewMouseLeftButtonDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,4" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Drag Handle Grip -->
                                            <Border Grid.Column="0" Width="22" Height="32" Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="SizeAll" ToolTip="{DynamicResource Main.DragCardTip}">
                                                <Path x:Name="DragGrip" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 4 5 h 2.5 v 2.5 H 4 Z M 9.5 5 h 2.5 v 2.5 H 9.5 Z M 4 10.5 h 2.5 v 2.5 H 4 Z M 9.5 10.5 h 2.5 v 2.5 H 9.5 Z M 4 16 h 2.5 v 2.5 H 4 Z M 9.5 16 h 2.5 v 2.5 H 9.5 Z"
                                                      Fill="#94A3B8" Width="10" Height="14" Stretch="Uniform"/>
                                            </Border>
                                            <Border x:Name="AvatarBorder" Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="AvatarText" Text="{Binding Initial}" FontSize="15" FontWeight="Bold" Foreground="#7C3AED"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1"
                                                            Visibility="{Binding PoolBadgeVisibility}">
                                                        <TextBlock Text="{DynamicResource Common.PoolBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                                            Visibility="{Binding UnpoolBadgeVisibility}">
                                                        <TextBlock Text="{DynamicResource Common.UnpoolBadge}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubText}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                            Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Background="#10B981" BorderBrush="#059669"
                                                        Visibility="{Binding AddBtnVisibility}" Click="OnRowAddPi">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlus}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Common.AddBtn}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Padding="12,6" Foreground="#EA580C" Background="#FFF7ED" BorderBrush="#FDBA74"
                                                        Visibility="{Binding RemoveBtnVisibility}" Click="OnRowRemovePi">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconTrash}" Fill="#EA580C" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Common.RemoveBtn}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="{DynamicResource Common.Edit}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCardEditPi"/>
                                                <Button Content="{DynamicResource Common.CopyCross}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCardCopyPi"/>
                                                <Button Content="{DynamicResource Common.Delete}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OnCardDeletePi"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardHoverBrush}"/>
                                            <Setter TargetName="Card" Property="Opacity" Value="1.0"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsInConfig}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#7C3AED"/>
                                            <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                                            <Setter TargetName="Card" Property="Background" Value="#FAF5FF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInConfig}" Value="False">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter TargetName="Card" Property="Background" Value="#FAFAFA"/>
                                            <Setter TargetName="Card" Property="Opacity" Value="0.85"/>
                                            <Setter TargetName="AvatarBorder" Property="Background" Value="#F1F5F9"/>
                                            <Setter TargetName="AvatarBorder" Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter TargetName="AvatarText" Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <StackPanel x:Name="PiEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextMutedBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Pi.EmptyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common.EmptyDesc}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <Button Content="{DynamicResource Common.EmptyAddBtn}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="OnAddPi"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
        </TabControl>

        <!-- ==================== Floating Toast Notification ==================== -->
        <Border x:Name="ToastBanner" Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,18,0,0" Panel.ZIndex="999"
                Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="10" Padding="16,10"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="#0F172A"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="ToastIcon" Data="{StaticResource IconCheck}" Fill="{StaticResource GreenBrush}"
                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Text="{DynamicResource Common.Toast}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ==================== Busy Overlay ==================== -->
        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#600F172A" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
                    Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="{StaticResource AccentBrush}" Background="#E2E8F0" BorderThickness="0"/>
                    <TextBlock x:Name="BusyText" Text="{DynamicResource Common.Busy}" FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Modern Drag & Drop Floating Ghost Overlay ==================== -->
        <Canvas x:Name="DragOverlayCanvas" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="99999">
            <Border x:Name="DragGhostBorder" CornerRadius="12"
                    BorderBrush="{DynamicResource TabAccentBrush}" BorderThickness="1.5"
                    Background="{DynamicResource CardBrush}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DragGhostScale" ScaleX="1.03" ScaleY="1.03"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.25"/>
                </Border.Effect>
                <Rectangle x:Name="DragGhostRect" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Canvas>
    </Grid>

</Window>
