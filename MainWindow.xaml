                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource DangerButton}" Padding="8,6" Margin="8,0,0,0" Click="OnCardDeleteAntigravity" ToolTip="{DynamicResource Ag.DeleteTip}">
