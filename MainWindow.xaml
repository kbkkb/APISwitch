                                                      Fill="#94A3B8" Width="10" Height="14" Stretch="Uniform"/>
                                            </Border>
                                            <!-- Avatar -->
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" VerticalAlignment="Center">
