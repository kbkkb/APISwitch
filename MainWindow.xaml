                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="23" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconOpenAi}" Fill="{StaticResource OpenAiBrush}" Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{DynamicResource Codex.HeroTitle}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Common.CurrentProvider}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
