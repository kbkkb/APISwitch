                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="打开 Pi 目录" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Cards List -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnCardsPreviewMouseWheel">
                        <ListBox x:Name="PiList" Margin="0,4,0,0" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource CardItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,4" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="20" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="Bold" Foreground="#D97706"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <Border x:Name="CurrentBadge" Style="{StaticResource CurrentBadge}">
                                                        <TextBlock Text="● 当前使用中" Style="{StaticResource BadgeGreenText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding SubText, Mode=OneWay}"/><Run Text="   ·   抓取于 "/><Run Text="{Binding CapturedAtLocal, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button x:Name="ApplyBtnCard" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OnRowApplyPi">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconZap}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="一键还原" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="删除" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OnCardDeletePi"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardHoverBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardActiveBorderBrush}"/>
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActiveBrush}"/>
                                            <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ApplyBtnCard" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <StackPanel x:Name="PiEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource IconSave}" Fill="{StaticResource TextMutedBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="还没有 Pi 凭据快照" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="未检测到 Pi（~/.pi/agent）或还没有抓取过凭据快照"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <Button Content="📸 立即抓取当前凭据" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="OnCapturePi"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
        </TabControl>

        <!-- ==================== Floating Toast Notification ==================== -->
        <Border x:Name="ToastBanner" Grid.Row="1"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,18,0,0" Panel.ZIndex="999"
                Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="10" Padding="16,10"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="#0F172A"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="ToastIcon" Data="{StaticResource IconCheck}" Fill="{StaticResource GreenBrush}"
                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Text="提示信息" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ==================== Busy Overlay ==================== -->
        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#600F172A" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
                    Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="{StaticResource AccentBrush}" Background="#E2E8F0" BorderThickness="0"/>
                    <TextBlock x:Name="BusyText" Text="正在处理，请稍候…" FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
