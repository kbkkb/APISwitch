        <!-- ==================== OpenCode ==================== -->
        <TabItem Tag="opencode">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconOpenCode}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform"/>
