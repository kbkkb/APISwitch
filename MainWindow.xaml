<Window x:Class="APISwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APISwitch"
        Height="720" Width="1140" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBgBrush}"
        PreviewMouseMove="OnWindowPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnWindowPreviewMouseLeftButtonUp"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dynamic Per-Tab Theme Brushes -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#E8EEFB"/>
        <SolidColorBrush x:Key="TitleBarBgBrush" Color="#E0E7F8"/>
        <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#CBD7EE"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#E8EEFB"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#CFDBEE"/>
        <SolidColorBrush x:Key="TabAccentBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TabAccentHoverBrush" Color="#4338CA"/>
        <SolidColorBrush x:Key="TabActiveBgBrush" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#C7D2FE"/>
        <SolidColorBrush x:Key="TabPageBgBrush" Color="#EDF2FE"/>
        <SolidColorBrush x:Key="HeroCardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeroCardBorderBrush" Color="#C7D2FE"/>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="236"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sidebar -->
                            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
                                <Grid Margin="0,10,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{DynamicResource Main.SidebarHeader}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="20,4,0,10"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>

                                    <!-- Bottom Utilities: Settings & Bug Feedback Button -->
                                    <StackPanel Grid.Row="2" Margin="12,12,12,0">
                                        <Border Height="1" Background="{DynamicResource SidebarBorderBrush}" Margin="4,0,4,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Click="OnOpenSettings" Style="{StaticResource GhostButton}" Padding="12,9" HorizontalContentAlignment="Stretch" ToolTip="{DynamicResource Main.SettingsTip}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource TabAccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Main.SettingsBtn}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                                    </StackPanel>
                                                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="{StaticResource IconChevronRight}" Fill="{StaticResource TextMutedBrush}" Width="7" Height="7" Stretch="Uniform"/>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Click="OnOpenBugFeedbackClick" Style="{StaticResource GhostButton}" Padding="10,9" Margin="6,0,0,0" ToolTip="{DynamicResource Main.BugTip}">
                                                <Path Data="{StaticResource IconBug}" Fill="{StaticResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tab Content -->
                            <Border Grid.Column="1" Background="{DynamicResource TabPageBgBrush}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTabItemPreviewMouseLeftButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Indicator" Width="3.5" Height="20" Fill="{DynamicResource TabAccentBrush}"
                                           RadiusX="1.75" RadiusY="1.75" HorizontalAlignment="Left"
                                           Visibility="Collapsed" Margin="-10,0,0,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                <Grid Grid.Column="2" x:Name="TabDragGrip" VerticalAlignment="Center" Margin="6,0,2,0"
                                      Cursor="SizeAll" ToolTip="{DynamicResource Main.DragTabTip}" Background="Transparent" Opacity="0.3">
                                    <Path Data="M 4 5 h 2.5 v 2.5 H 4 Z M 9.5 5 h 2.5 v 2.5 H 9.5 Z M 4 10.5 h 2.5 v 2.5 H 4 Z M 9.5 10.5 h 2.5 v 2.5 H 9.5 Z M 4 16 h 2.5 v 2.5 H 4 Z M 9.5 16 h 2.5 v 2.5 H 9.5 Z"
                                          Fill="#64748B" Width="9" Height="13" Stretch="Uniform"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                <Setter TargetName="TabDragGrip" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabAccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="TabDragGrip" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Avatar" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AvatarText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CurrentBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GreenDimBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GreenBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeGreenText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MiniQuotaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Custom TitleBar ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}" BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="pack://application:,,,/Assets/apiswitch.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="APISwitch" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="UpdateCheckBtn" Click="OnCheckUpdateClick" Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                            Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{DynamicResource Main.NewVersionTip}"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="UpdateIcon" Data="{StaticResource IconUpgrade}" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="AppVersionText" Text="{DynamicResource Main.NewVersion}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                            <Border x:Name="UpdateBadge" Background="#EF4444" CornerRadius="4" Padding="4,1" Margin="5,0,0,0"
                                    Visibility="Visible" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateBadgeText" Text="{DynamicResource Main.Upgrade}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Middle Draggable Space -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0"/>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionBtn}" Tag="{StaticResource IconMin}" Click="OnMinWindow" ToolTip="{DynamicResource Main.MinTip}"/>
                    <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionBtn}" Tag="{StaticResource IconMax}" Click="OnMaxWindow" ToolTip="{DynamicResource Main.MaxTip}"/>
                    <Button Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}" Click="OnCloseWindow" ToolTip="{DynamicResource Main.CloseTip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Main Content Tabs ==================== -->
        <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">

        <!-- ==================== 谷歌反重力 ==================== -->
        <TabItem Tag="antigravity">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/antigravity.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Antigravity" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Main.TabAgSub}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="28,14,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Status Card -->
                <Border Grid.Row="0" Background="{DynamicResource HeroCardBgBrush}" BorderBrush="{DynamicResource HeroCardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentGradient}" VerticalAlignment="Center">
                            <TextBlock Text="G" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Google Antigravity" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <Border x:Name="CurrentAgBadge" Background="{StaticResource GreenDimBrush}" BorderBrush="{StaticResource GreenBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Ag.HeroBadgeReady}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Ag.CurrentAccountLabel}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock x:Name="CurrentAccountText" Text="{DynamicResource Ag.Detecting}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                    <TextBlock x:Name="StateChip" Text="—" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                    <TextBlock x:Name="PlanChip" Text="—" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                    <TextBlock x:Name="IdeChip" Text="—" FontSize="11" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DbPathText" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                    <Button Style="{StaticResource PrimaryButton}" Click="OnNewAccountLogin" ToolTip="{DynamicResource Ag.LoginTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUserPlus}" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Ag.LoginBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BatchActivateBtn" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnBatchActivateAntigravity" ToolTip="{DynamicResource Ag.BatchActivateTip}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconZap}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Ag.BatchActivateBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnLaunchIde">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRocket}" Fill="{StaticResource TextDimBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Ag.LaunchIdeBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnImportFromAgTools" ToolTip="{DynamicResource Ag.ImportToolsTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconImport}" Fill="{StaticResource TextDimBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Ag.ImportToolsBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnRefresh" ToolTip="{DynamicResource Ag.RefreshTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextDimBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.Refresh}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="AutoRestartCheck" Content="{DynamicResource Ag.AutoRestartCheck}" IsChecked="True" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12"/>
                </StackPanel>

                <!-- Account Cards List -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="AgScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnCardsPreviewMouseWheel">
                        <ListBox x:Name="ProfileList" Margin="0,4,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 PreviewMouseLeftButtonDown="OnCardListPreviewMouseLeftButtonDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,15" Margin="0,5" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Avatar, Info, Badges & Actions -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Drag Handle Grip -->
                                                <Border Grid.Column="0" Width="22" Height="32" Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="SizeAll" ToolTip="{DynamicResource Main.DragCardTip}">
                                                    <Path x:Name="DragGrip" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 4 5 h 2.5 v 2.5 H 4 Z M 9.5 5 h 2.5 v 2.5 H 9.5 Z M 4 10.5 h 2.5 v 2.5 H 4 Z M 9.5 10.5 h 2.5 v 2.5 H 9.5 Z M 4 16 h 2.5 v 2.5 H 4 Z M 9.5 16 h 2.5 v 2.5 H 9.5 Z"
                                                          Fill="#94A3B8" Width="10" Height="14" Stretch="Uniform"/>
                                                </Border>

                                                <!-- Avatar Initial -->
                                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Email, Name & Tier -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Email}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                        <Border x:Name="CurrentBadge" Style="{StaticResource CurrentBadge}">
                                                            <TextBlock Text="{DynamicResource Ag.CurrentBadge}" Style="{StaticResource BadgeGreenText}"/>
                                                        </Border>
                                                        <!-- Tier Badge -->
                                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TierDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                        <!-- Activation Badge -->
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="{Binding ActivationTooltip}">
                                                            <TextBlock Text="{Binding ActivationStatusText}" FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActivated}" Value="True">
                                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsActivated}" Value="False">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding QuotaUpdatedText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <Button x:Name="SwitchBtnCard" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OnRowSwitchAntigravity" ToolTip="{DynamicResource Ag.SwitchTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconZap}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{DynamicResource Ag.SwitchBtn}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="8,0,0,0" Click="OnCardActivateQuota" ToolTip="{DynamicResource Ag.ActivateQuotaTip}" Visibility="Collapsed">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path x:Name="ActivateIcon" Data="{StaticResource IconZap}" Fill="{StaticResource AccentBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <Path.RenderTransform>
                                                                    <RotateTransform x:Name="ActivateIconRotate" Angle="0"/>
                                                                </Path.RenderTransform>
                                                            </Path>
                                                            <TextBlock Text="{DynamicResource Ag.ActivateQuotaBtn}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="8,0,0,0" Click="OnCardRefreshQuota" ToolTip="{DynamicResource Ag.RefreshQuotaTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextDimBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
