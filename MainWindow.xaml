<Window x:Class="APISwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APISwitch - 一站式 AI 编程账号切换器"
        Height="720" Width="1140" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, -apple-system, 'Microsoft YaHei UI', 'PingFang SC', sans-serif"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="236"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sidebar -->
                            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                <Grid Margin="0,10,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="AI 编程工具" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="20,4,0,10"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>

                                    <!-- Bottom Utilities -->
                                    <StackPanel Grid.Row="2" Margin="12,12,12,0">
                                        <Border Height="1" Background="#E2E8F0" Margin="4,0,4,12"/>
                                        <Button Click="OnImportCc" Style="{StaticResource GhostButton}" Padding="11,8" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Path Data="{StaticResource IconImport}" Fill="{StaticResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="从 cc-switch 导入" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnOpenFolder" Style="{StaticResource GhostButton}" Padding="11,7" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="打开数据存档目录" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnCheckUpdateClick" Style="{StaticResource GhostButton}" Padding="11,7">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextDimBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="检查软件更新" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tab Content -->
                            <Border Grid.Column="1" Background="{StaticResource BgBrush}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Indicator" Width="3" Height="20" Fill="{StaticResource AccentBrush}"
                                           RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                           Visibility="Collapsed" Margin="-12,0,0,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Avatar" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AvatarText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CurrentBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GreenDimBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GreenBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="BadgeGreenText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MiniQuotaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Custom TitleBar ==================== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="pack://application:,,,/Assets/apiswitch.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="APISwitch" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Button Click="OnCheckUpdateClick" Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                            Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="点击检查新版本">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="AppVersionText" Text="v0.1.1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <Border x:Name="UpdateBadge" Background="#EF4444" CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="New" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Middle Draggable Space & Router Status -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                    <TextBlock Text="一站式 AI 编程账号与供应商切换器" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button x:Name="TitleBarRouterBtn" HorizontalAlignment="Right" Click="OnToggleProxyServer" Style="{StaticResource GhostButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Padding="8,3"
                            ToolTip="点击开启/关闭本地路由服务（提供协议转译与无缝热切换）">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="RouterStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock x:Name="RouterStatusText" Text="本地路由 :15725" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionBtn}" Tag="{StaticResource IconMin}" Click="OnMinWindow" ToolTip="最小化"/>
                    <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionBtn}" Tag="{StaticResource IconMax}" Click="OnMaxWindow" ToolTip="最大化/还原"/>
                    <Button Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}" Click="OnCloseWindow" ToolTip="最小化隐藏"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Main Content Tabs ==================== -->
        <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">

        <!-- ==================== 谷歌反重力 ==================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/antigravity.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="谷歌反重力" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Antigravity IDE" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="28,14,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Status Card -->
                <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource AccentGradient}" VerticalAlignment="Center">
                            <TextBlock Text="G" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Google Antigravity" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <Border x:Name="CurrentAgBadge" Background="{StaticResource GreenDimBrush}" BorderBrush="{StaticResource GreenBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="● 检测就绪" FontSize="11" FontWeight="Medium" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="当前账号：" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock x:Name="CurrentAccountText" Text="检测中…" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                    <TextBlock x:Name="StateChip" Text="—" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                    <TextBlock x:Name="PlanChip" Text="—" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                    <TextBlock x:Name="IdeChip" Text="—" FontSize="11" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DbPathText" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="2,6,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                    <Button Style="{StaticResource PrimaryButton}" Click="OnImportFromAgTools" ToolTip="从 Antigravity Tools 一键导入全部账号和配额">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconImport}" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="导入 Tools 账号" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnNewAccountLogin" ToolTip="打开 Google 官方登录网页授权新账号">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUserPlus}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="登录新账号 (网页端)" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnBatchActivateAntigravity" ToolTip="以安全防风控策略（串行排队 + 随机间隔）一键握手激活全部账号并测通可用性">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconZap}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="⚡ 批量激活" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnLaunchIde">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRocket}" Fill="{StaticResource TextDimBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="启动 IDE" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnRefresh" ToolTip="一键静默刷新所有账号的最新配额与状态">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextDimBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="AutoRestartCheck" Content="切换后自动重启 IDE" IsChecked="True" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12"/>
                </StackPanel>

                <!-- Account Cards List -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="AgScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnCardsPreviewMouseWheel">
                        <ListBox x:Name="ProfileList" Margin="0,4,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource CardItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,15" Margin="0,5" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Avatar, Info, Badges & Actions -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar Initial -->
                                                <Border Width="42" Height="42" CornerRadius="21" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Email, Name & Tier -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Email}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                        <Border x:Name="CurrentBadge" Style="{StaticResource CurrentBadge}">
                                                            <TextBlock Text="● 当前激活" Style="{StaticResource BadgeGreenText}"/>
                                                        </Border>
                                                        <!-- Tier Badge -->
                                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TierDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                        <!-- Activation Badge -->
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="{Binding ActivationTooltip}">
                                                            <TextBlock Text="{Binding ActivationStatusText}" FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActivated}" Value="True">
                                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsActivated}" Value="False">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding QuotaUpdatedText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <Button x:Name="SwitchBtnCard" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OnRowSwitchAntigravity" ToolTip="切换 Antigravity IDE 到此账号">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconZap}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                            <TextBlock Text="切换账户" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="8,0,0,0" Click="OnCardActivateQuota" ToolTip="向 Google 发送消息以激活该账号的限额周期并同步刷新配额">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconZap}" Fill="{StaticResource AccentBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                            <TextBlock Text="激活限额" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="8,0,0,0" Click="OnCardRefreshQuota" ToolTip="在线查询并刷新此账号的最新配额">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextDimBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                            <TextBlock Text="刷新配额" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource DangerButton}" Padding="8,6" Margin="8,0,0,0" Click="OnCardDeleteAntigravity" ToolTip="删除本地存档">
                                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 1: Dual Quota Metrics Panel (Gemini & Claude/GPT) -->
                                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left Column: Gemini Models -->
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <Border Background="#EEF2FF" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="Gemini 模型" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Gemini 5H -->
                                                        <Grid Margin="0,0,0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="5H 动态限额" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextDimBrush}"/>
                                                                <TextBlock Text="{Binding Quota5hCountdown}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Quota5hPercentText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ProgressBar Style="{StaticResource MiniQuotaProgress}" Value="{Binding Quota5hPercentValue, Mode=OneWay}" Margin="0,0,0,8"
                                                                     Foreground="{StaticResource GreenBrush}"/>

                                                        <!-- Gemini Weekly -->
                                                        <Grid Margin="0,0,0,3">
                                                            <StackPanel Orientation="Horizontal">
