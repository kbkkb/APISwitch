                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.AddProvider}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnImportCc">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconImport}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.CcImport}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CodexToolbarRouterBtn" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnToggleCodexProxy" ToolTip="{DynamicResource Main.RouterToggleTip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CodexToolbarRouterDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CodexToolbarRouterText" Text="{DynamicResource Router.ToolbarOff}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnRestartCodex">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Codex.RestartBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenCodexConfig">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExternal}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Codex.OpenConfigBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Cards List -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnCardsPreviewMouseWheel">
                        <ListBox x:Name="CodexList" Margin="0,4,0,0" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 PreviewMouseLeftButtonDown="OnCardListPreviewMouseLeftButtonDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,4" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Drag Handle Grip -->
                                            <Border Grid.Column="0" Width="22" Height="32" Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="SizeAll" ToolTip="{DynamicResource Main.DragCardTip}">
                                                <Path x:Name="DragGrip" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 4 5 h 2.5 v 2.5 H 4 Z M 9.5 5 h 2.5 v 2.5 H 9.5 Z M 4 10.5 h 2.5 v 2.5 H 4 Z M 9.5 10.5 h 2.5 v 2.5 H 9.5 Z M 4 16 h 2.5 v 2.5 H 4 Z M 9.5 16 h 2.5 v 2.5 H 9.5 Z"
                                                      Fill="#94A3B8" Width="10" Height="14" Stretch="Uniform"/>
                                            </Border>
                                            <!-- Avatar -->
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OpenAiBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <Border x:Name="CurrentBadge" Style="{StaticResource CurrentBadge}">
                                                        <TextBlock Text="{DynamicResource Common.InUseBadge}" Style="{StaticResource BadgeGreenText}"/>
                                                    </Border>
                                                    <Border Background="{Binding RouterBadgeBackground}" BorderBrush="{Binding RouterBadgeBorderBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" Visibility="{Binding RouterBadgeVisibility}"
                                                            ToolTip="{Binding RouterBadgeTooltip}">
                                                        <TextBlock Text="{Binding RouterBadgeText}" FontSize="11" FontWeight="Medium"
                                                                   Foreground="{Binding RouterBadgeForeground}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubText}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button x:Name="ApplyBtnCard" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OnRowApplyCodex">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconZap}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Common.ApplyBtn}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="{DynamicResource Common.Edit}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCardEditCodex"/>
                                                <Button Content="{DynamicResource Common.CopyCross}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCardCopyCodex"/>
                                                <Button Content="{DynamicResource Common.Delete}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OnCardDeleteCodex"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardHoverBrush}"/>
                                            <Setter TargetName="DragGrip" Property="Fill" Value="#94A3B8"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardActiveBorderBrush}"/>
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActiveBrush}"/>
                                            <Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ApplyBtnCard" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <StackPanel x:Name="CodexEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextMutedBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Codex.EmptyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common.EmptyDesc}"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <Button Content="{DynamicResource Common.EmptyAddBtn}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="OnAddCodex"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
        <!-- ==================== Claude Code ==================== -->
        <TabItem Tag="claude">
