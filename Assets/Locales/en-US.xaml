    <!-- ==================== Page: About ==================== -->
    <sys:String x:Key="About.PageTitle">About &amp; Update</sys:String>
    <sys:String x:Key="About.Tagline">Switch and manage third-party APIs &amp; Google subscriptions</sys:String>
    <sys:String x:Key="About.SupportedTitle">Supported apps &amp; clients:</sys:String>
    <sys:String x:Key="About.S1">• Google Antigravity (official subscription &amp; quick account switching)</sys:String>
    <sys:String x:Key="About.S2">• OpenAI Codex (provider config &amp; local protocol hot-swap)</sys:String>
    <sys:String x:Key="About.S3">• Anthropic Claude Code CLI (terminal provider management)</sys:String>
    <sys:String x:Key="About.S4">• Claude Desktop (desktop model mapping &amp; routing takeover)</sys:String>
    <sys:String x:Key="About.S5">• OpenCode (provider &amp; model pool management)</sys:String>
    <sys:String x:Key="About.S6">• Pi (Minimal Agent multi-model config &amp; auth)</sys:String>
