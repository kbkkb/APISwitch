    <!-- ==================== Page: Sync ==================== -->
    <sys:String x:Key="Sync.PageTitle">数据备份与多设备同步</sys:String>
    <sys:String x:Key="Sync.ExportTitle">一键导出所有配置 (Backup)</sys:String>
    <sys:String x:Key="Sync.ExportDesc">包含 Codex、Claude CLI、Claude Desktop、OpenCode、Pi 供应商以及 Antigravity 账号数据与侧边栏排序，生成标准 JSON 备份。</sys:String>
