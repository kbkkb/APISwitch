    <!-- ==================== Page: About ==================== -->
    <sys:String x:Key="About.PageTitle">关于与更新</sys:String>
    <sys:String x:Key="About.Tagline">第三方 API 和谷歌官方订阅切换与管理</sys:String>
    <sys:String x:Key="About.SupportedTitle">已支持的应用与客户端：</sys:String>
    <sys:String x:Key="About.S1">• Google Antigravity（官方订阅与账号快捷切换）</sys:String>
    <sys:String x:Key="About.S2">• OpenAI Codex（API 供应商配置与本地协议热切）</sys:String>
    <sys:String x:Key="About.S3">• Anthropic Claude Code CLI（终端命令行供应商管理）</sys:String>
    <sys:String x:Key="About.S4">• Claude Desktop（桌面客户端模型映射与路由接管）</sys:String>
    <sys:String x:Key="About.S5">• OpenCode（供应商与模型配置池管理）</sys:String>
    <sys:String x:Key="About.S6">• Pi（Minimal Agent 多模型配置与鉴权管理）</sys:String>
    <sys:String x:Key="About.GitHubBtn">访问 GitHub 仓库</sys:String>
    <sys:String x:Key="About.FeedbackBtn">Bug 反馈 / 建议</sys:String>
    <sys:String x:Key="About.Ack">致谢：感谢 cc-switch、Antigravity Tool 与 LINUX DO 社区</sys:String>
    <sys:String x:Key="About.UpdateTitle">软件更新检查</sys:String>
    <sys:String x:Key="About.UpdateDesc">APISwitch 会在启动时自动检测 GitHub Release 的稳定版本更新，保持协议转译与工具支持最新。</sys:String>
    <sys:String x:Key="About.AutoCheck">启动时自动检查新版本</sys:String>
    <sys:String x:Key="About.CheckNowBtn">立即检查更新</sys:String>

