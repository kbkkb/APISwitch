<UserControl x:Class="APISwitch.Dialogs.DateTimePickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <!-- 日期格子 -->
        <Style x:Key="DayCell" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小图标按钮（月份翻页 / 时间步进） -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 时间框（左右箭头 + 可点击文本） -->
        <Style x:Key="StepperBox" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <!-- 弹层内的文字按钮（此刻 / 完成） -->
        <Style x:Key="PopBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 星期表头 -->
        <Style x:Key="DowHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 字段按钮 -->
        <ToggleButton x:Name="Toggle" Cursor="Hand" Focusable="False" ToolTip="{DynamicResource Usage.PickerTip}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Height="32" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="#F5F7FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <ToggleButton.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconCalendar}" Fill="#94A3B8"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FieldText" Grid.Column="1" Margin="7,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" FontFamily="{StaticResource AppFontFamily}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="106"/>
                </Grid>
            </ToggleButton.Content>
        </ToggleButton>

        <!-- 弹出面板 -->
        <Popup x:Name="Pop" AllowsTransparency="True" StaysOpen="False"
               Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}">
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="12" Padding="12" Width="272" Margin="10,4,10,14">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.16" BlurRadius="20" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 月份导航 -->
                    <Grid Height="30" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevMonthBtn" Grid.Column="0" Style="{StaticResource IconBtn}" Content="‹" FontSize="16"/>
                        <TextBlock x:Name="MonthTitle" Grid.Column="1" Text="2026年9月" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="NextMonthBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Content="›" FontSize="16"/>
                    </Grid>

                    <!-- 星期表头 -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Usage.Dow1}" Style="{StaticResource DowHead}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Usage.Dow2}" Style="{StaticResource DowHead}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Usage.Dow3}" Style="{StaticResource DowHead}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Usage.Dow4}" Style="{StaticResource DowHead}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Usage.Dow5}" Style="{StaticResource DowHead}"/>
                        <TextBlock Grid.Column="5" Text="{DynamicResource Usage.Dow6}" Style="{StaticResource DowHead}"/>
                        <TextBlock Grid.Column="6" Text="{DynamicResource Usage.Dow0}" Style="{StaticResource DowHead}"/>
                    </Grid>

                    <!-- 日期网格 -->
                    <UniformGrid x:Name="DayGrid" Rows="6" Columns="7" HorizontalAlignment="Center"/>

                    <Border Height="1" Background="#F1F5F9" Margin="0,10,0,10"/>

                    <!-- 时间：两个独立框（左右箭头步进 + 点文本切表盘） -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 时 -->
                            <Border x:Name="HourBox" Grid.Column="0" Style="{StaticResource StepperBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="HourDownBtn" Grid.Column="0" Style="{StaticResource IconBtn}" Content="‹"/>
                                    <TextBlock x:Name="HourText" Grid.Column="1" Text="00" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Cursor="Hand"/>
                                    <Button x:Name="HourUpBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Content="›"/>
                                </Grid>
                            </Border>

                            <!-- 分 -->
                            <Border x:Name="MinuteBox" Grid.Column="2" Style="{StaticResource StepperBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MinuteDownBtn" Grid.Column="0" Style="{StaticResource IconBtn}" Content="‹"/>
                                    <TextBlock x:Name="MinuteText" Grid.Column="1" Text="00" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Cursor="Hand"/>
                                    <Button x:Name="MinuteUpBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Content="›"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 表盘：点文本切换对应表盘；支持按住拖动实时改值 -->
                        <Canvas x:Name="Dial" Width="204" Height="204" HorizontalAlignment="Center" Cursor="Hand"
                                Background="Transparent"/>
                    </StackPanel>

                    <!-- 操作：完成为主按钮（最大、实色），此刻为次按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DoneBtn" Grid.Column="0" Style="{StaticResource PopBtn}"
                                Content="{DynamicResource Usage.Done}" Background="#4F46E5" Foreground="#FFFFFF"/>
                        <Button x:Name="NowBtn" Grid.Column="2" Style="{StaticResource PopBtn}"
                                Content="{DynamicResource Usage.Now}" Background="#EEF2FF" Foreground="#4F46E5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
