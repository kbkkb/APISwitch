<Window x:Class="APISwitch.Dialogs.ProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="供应商配置"
        Width="820" Height="750" MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, -apple-system, 'Microsoft YaHei UI', 'PingFang SC', sans-serif"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgBrush}" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText" Text="编辑供应商" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="CategoryBadge" Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="{StaticResource AccentDimBrush}">
                            <TextBlock x:Name="CategoryBadgeText" Text="Codex" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel" ToolTip="关闭窗口"/>
                </Grid>
            </Border>

            <!-- 2. Scrollable Content Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,18,28,20">
                <StackPanel>
                    <!-- Official CheckBox -->
                    <CheckBox x:Name="OfficialCheck" Content="官方配置（清除第三方端点，恢复官方登录）"
                              Margin="0,0,0,16" Checked="OfficialCheck_Changed" Unchecked="OfficialCheck_Changed"/>

                    <StackPanel x:Name="FieldsPanel">
                        <!-- ID -->
                        <TextBlock Text="供应商标识 *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="IdBox" Tag="例如：my-proxy 或 gn" Margin="0,0,0,2"/>
                        <TextBlock x:Name="IdHintText" Text="作为应用内部与配置文件的唯一标识 (Slug)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,12"/>

                        <!-- Name & Notes (Two columns) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="供应商名称 *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" Tag="例如：我的中转服务"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="备注" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NotesBox" Tag="例如：公司专用账号"/>
                            </StackPanel>
                        </Grid>

                        <!-- Website URL -->
                        <TextBlock Text="官网链接" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="WebsiteUrlBox" Tag="https://example.com" Margin="0,0,0,12"/>

                        <!-- API Format / Wire API Panel -->
                        <StackPanel x:Name="FormatPanel" Margin="0,0,0,12">
                            <!-- Claude Model Config & Wire API Panel -->
                            <StackPanel x:Name="ClaudeConfigPanel" Visibility="Collapsed" Margin="0,0,0,4">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="模型配置" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="ClaudeConfigDescText" Text="Claude 客户端只接受 claude-sonnet-* / claude-opus-* / claude-haiku-* 角色 ID。选择模型映射后，将自动映射到供应商的实际模型，并保持本地路由开启。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="接入方式" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ClaudeAccessModeCombo" Width="120" Height="32" SelectionChanged="ClaudeAccessMode_Changed">
                                            <ComboBoxItem Tag="mapping" Content="模型映射" IsSelected="True"/>
                                            <ComboBoxItem Tag="direct" Content="直接指定"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="上游格式" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ClaudeWireCombo" Height="34" SelectionChanged="ClaudeWireCombo_Changed">
                                        <ComboBoxItem Tag="anthropic" Content="Anthropic Messages（原生）" IsSelected="True"/>
                                        <ComboBoxItem Tag="chat" Content="Chat Completions（需开启路由）"/>
                                        <ComboBoxItem Tag="responses" Content="OpenAI Responses（需开启路由）"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Codex Wire API -->
                            <StackPanel x:Name="CodexWirePanel">
                                <TextBlock Text="上游格式 (Wire API)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="选择底层通信协议格式（对应 Codex wire_api）" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CodexWireCombo" Height="36" Margin="0,0,0,4">
                                    <ComboBoxItem Tag="responses" Content="Responses（原生）" IsSelected="True"/>
                                    <ComboBoxItem Tag="chat" Content="Chat Completions（需开启路由）"/>
                                    <ComboBoxItem Tag="anthropic" Content="Anthropic Messages（需开启路由）"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- OpenCode Npm -->
                            <StackPanel x:Name="OpenCodeFormatPanel" Visibility="Collapsed">
                                <TextBlock Text="接口格式 (npm 包)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="选择 AI 服务的 API 接口格式驱动" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="OcNpmCombo" IsEditable="True" Height="34" Margin="0,0,0,4">
                                    <ComboBoxItem Content="@ai-sdk/openai-compatible" IsSelected="True"/>
                                    <ComboBoxItem Content="@ai-sdk/anthropic"/>
                                    <ComboBoxItem Content="@ai-sdk/google"/>
                                    <ComboBoxItem Content="@ai-sdk/azure"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Pi Api Format -->
                            <StackPanel x:Name="PiFormatPanel" Visibility="Collapsed">
                                <TextBlock Text="接口协议 (api)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="选择 Pi Agent 调用的底层 API 协议" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PiApiCombo" IsEditable="True" Height="34" Margin="0,0,0,4">
                                    <ComboBoxItem Content="openai-completions" IsSelected="True"/>
                                    <ComboBoxItem Content="anthropic-messages"/>
                                    <ComboBoxItem Content="openai-responses"/>
                                    <ComboBoxItem Content="google-generative-ai"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- API Key / Token -->
                        <TextBlock x:Name="KeyLabel" Text="API Key *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,2">
                            <PasswordBox x:Name="KeyPasswordBox" MinHeight="38" Padding="12,8,42,8"
                                         FontFamily="Consolas, Cascadia Code, Segoe UI"/>
                            <TextBox x:Name="KeyTextBox" Tag="sk-..." MinHeight="38" Padding="12,8,42,8"
                                     FontFamily="Consolas, Cascadia Code, Segoe UI" Visibility="Collapsed"/>
                            <Button x:Name="ToggleKeyBtn" Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="36" Height="32" Margin="0,0,3,0"
                                    Click="ToggleKeyVisibility_Click" ToolTip="切换显隐">
                                <Path x:Name="EyeIconPath" Data="{StaticResource IconEye}" Fill="{StaticResource TextDimBrush}"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="KeyHintText" Text="系统将安全写入本地配置文件与凭据系统" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,12"/>

                        <!-- Base URL -->
                        <TextBlock x:Name="BaseUrlLabel" Text="Base URL" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="自定义 API 端点地址" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="BaseUrlBox" Tag="https://api.example.com/v1" Margin="0,0,0,14"/>

                        <!-- Default Model & Small Fast Model -->
                        <Grid x:Name="DirectModelPanel" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="SmallFastColSpace" Width="16"/>
                                <ColumnDefinition x:Name="SmallFastCol" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="默认模型（可选）" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ModelCombo" IsEditable="True" Height="36"
                                          ItemsSource="{Binding FetchedModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Tag="例如：gpt-4o、claude-3-7-sonnet"/>
                            </StackPanel>

                            <StackPanel x:Name="SmallFastPanel" Grid.Column="2">
                                <TextBlock Text="Small / Fast 模型（可选）" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SmallFastCombo" IsEditable="True" Height="36"
                                          ItemsSource="{Binding FetchedModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Tag="例如：claude-3-5-haiku"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                        <!-- Custom Headers Section -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="请求头" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="随供应商请求发送的可选 HTTP 请求头，如 HTTP-Referer 或 X-Title。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="+ 添加请求头" Style="{StaticResource GhostButton}" Click="AddHeader_Click"/>
                        </Grid>
                        <TextBlock x:Name="EmptyHeadersText" Text="暂无自定义请求头" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,10"/>
                        <ItemsControl x:Name="HeadersItemsControl" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Header 键名" ToolTip="Header 键名"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Header 键值" ToolTip="Header 键值"/>
                                        <Button Grid.Column="4" Style="{StaticResource DangerButton}" Padding="0" Click="DeleteHeader_Click" ToolTip="删除">
                                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                        <!-- Extra Options Section -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="额外选项" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="配置额外的 SDK 选项，如 timeout、setCacheKey 等。值会自动解析类型（数字、布尔值等）。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="+ 添加" Style="{StaticResource GhostButton}" Click="AddOption_Click"/>
                        </Grid>
                        <TextBlock x:Name="EmptyOptionsText" Text="暂无额外选项" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,10"/>
                        <ItemsControl x:Name="OptionsItemsControl" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="选项键名" ToolTip="选项键名"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="选项键值" ToolTip="选项键值"/>
                                        <Button Grid.Column="4" Style="{StaticResource DangerButton}" Padding="0" Click="DeleteOption_Click" ToolTip="删除">
                                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                        <!-- Claude 4-Role Model Mapping Section -->
                        <StackPanel x:Name="ClaudeModelMappingSection" Visibility="Collapsed">
                            <!-- Header -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="模型映射" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="为 Sonnet、Opus、Fable、Haiku 四档分别填写实际请求模型；菜单显示名可写 DeepSeek、Kimi 等品牌名。留空的档会自动沿用 Sonnet（或第一个已填档）的模型，确保子 agent 调用的 Haiku 始终可用。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Click="FetchModels_Click" ToolTip="通过 Base URL 和鉴权自动探测可用模型">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCloud}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="ClaudeFetchModelsBtnText" Text="获取模型列表" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Table Header -->
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模型角色" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="2" Text="菜单显示名" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="4" Text="实际请求模型" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="6" Text="声明支持 1M" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- 4 Fixed Mapping Rows ItemsControl -->
                            <ItemsControl x:Name="ClaudeMappingItemsControl" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Role Badge -->
                                            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                                    CornerRadius="6" Height="34" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="12" Foreground="#334155"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Display Name Box -->
                                            <TextBox Grid.Column="2" Height="34" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="菜单显示名" ToolTip="在客户端/CLI 菜单中显示的友好名称"/>

                                            <!-- Actual Model ComboBox -->
                                            <ComboBox Grid.Column="4" Height="34" IsEditable="True"
                                                      Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FetchedModels}"
                                                      SelectionChanged="ClaudeModelCombo_SelectionChanged"
                                                      Tag="输入或下拉选择实际请求模型" ToolTip="实际发送到上游中转站的模型标识"/>

                                            <!-- Supports 1M CheckBox -->
                                            <CheckBox Grid.Column="6" Content="1M" IsChecked="{Binding Supports1m, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ToolTip="勾选后声明该模型支持 1M 扩展上下文窗口（CLI 会添加 [1M] 标识）"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Codex / OpenCode Models Configuration Section -->
                        <StackPanel x:Name="CodexModelsSection">
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="模型配置" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="配置可用的模型及其显示名称" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button x:Name="FetchModelsBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="FetchModels_Click" ToolTip="通过 Base URL 和鉴权自动探测可用模型">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloud}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="FetchModelsBtnText" Text="获取模型列表" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="+ 添加模型" Style="{StaticResource GhostButton}" Click="AddModel_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fetched Models Temporary Pool Banner & Quick Selector -->
                            <Border x:Name="FetchedModelsBar" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCloud}" Fill="#16A34A" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FetchedModelsTitleText" Text="已从端点暂存 0 个模型" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                        <TextBlock Text="（可下拉选为默认模型或添加到列表，未自动污染已有配置）" FontSize="11" Foreground="#166534" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SelectModelToAddCombo" Grid.Column="0" Height="34" IsEditable="True"
                                                  ItemsSource="{Binding FetchedModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Tag="选择或输入要添加的模型..."/>
                                        <Button Grid.Column="2" Content="+ 添加所选模型" Style="{StaticResource PrimaryButton}" Padding="12,4" Height="34" FontSize="12" Click="AddSelectedFetchedModel_Click"/>
                                        <Button Grid.Column="4" x:Name="AddAllFetchedBtn" Content="一键全部添加" Style="{StaticResource GhostButton}" Padding="10,4" Height="34" FontSize="12" Click="AddAllFetchedModels_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="EmptyModelsText" Text="暂无模型配置（将使用系统默认模型）" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,10"/>
                            <ItemsControl x:Name="ModelsItemsControl" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="›" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" IsEditable="True" Height="34"
                                                      Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FetchedModels}"
                                                      Tag="模型 ID，如 moonshotai/kimi-k3" ToolTip="模型 ID（可下拉选择已暂存模型或手动输入）"/>
                                            <TextBox Grid.Column="3" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="显示名称 (可选)" ToolTip="显示名称（可选）"/>
                                            <TextBox Grid.Column="5" Text="{Binding ContextWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="上下文 (1m)" ToolTip="上下文窗口（支持 1m, 128k, 200k 或具体数字，默认 1m）"/>
                                            <Button Grid.Column="7" Style="{StaticResource DangerButton}" Padding="0" Click="DeleteModel_Click" ToolTip="删除模型">
                                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                        <!-- JSON / Config Preview -->
                        <TextBlock Text="配置 JSON" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <TextBox x:Name="JsonPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                     Foreground="#334155" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="24,12">
                <Grid>
                    <TextBlock x:Name="StatusMessageText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,210,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Width="80" Margin="0,0,10,0" Click="OnCancel" IsCancel="True"/>
                        <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="OnOk" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSave}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="保存" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
