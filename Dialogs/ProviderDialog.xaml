<Window x:Class="APISwitch.Dialogs.ProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PD.Title}"
        Width="820" Height="750" MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}" BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText" Text="{DynamicResource PD.EditTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="CategoryBadge" Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource TabActiveBgBrush}" BorderBrush="{DynamicResource TabActiveBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="CategoryBadgeText" Text="Codex" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel" ToolTip="{DynamicResource PD.CloseTip}"/>
                </Grid>
            </Border>

            <!-- 2. Scrollable Content Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,18,28,20">
                <StackPanel>
                    <!-- Official CheckBox -->
                    <CheckBox x:Name="OfficialCheck" Content="{DynamicResource PD.OfficialCheck}"
                              Margin="0,0,0,16" Checked="OfficialCheck_Changed" Unchecked="OfficialCheck_Changed"/>

                    <StackPanel x:Name="FieldsPanel">
                        <!-- ID -->
                        <TextBlock Text="{DynamicResource PD.IdLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="IdBox" Tag="{DynamicResource PD.IdTag}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="IdHintText" Text="{DynamicResource PD.IdHint}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,12"/>

                        <!-- Name & Notes (Two columns) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource PD.NameLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" Tag="{DynamicResource PD.NameTag}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource PD.NotesLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NotesBox" Tag="{DynamicResource PD.NotesTag}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Website URL -->
                        <TextBlock Text="{DynamicResource PD.WebsiteLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="WebsiteUrlBox" Tag="https://example.com" Margin="0,0,0,12"/>

                        <!-- API Format / Wire API Panel -->
                        <StackPanel x:Name="FormatPanel" Margin="0,0,0,12">
                            <!-- Claude Model Config & Wire API Panel -->
                            <StackPanel x:Name="ClaudeConfigPanel" Visibility="Collapsed" Margin="0,0,0,4">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource PD.ModelConfigTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="ClaudeConfigDescText" Text="{DynamicResource PD.ClaudeDescDefault}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource PD.AccessModeLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ClaudeAccessModeCombo" Width="120" Height="32" SelectionChanged="ClaudeAccessMode_Changed">
                                            <ComboBoxItem Tag="mapping" Content="{DynamicResource PD.AccessModeMapping}" IsSelected="True"/>
                                            <ComboBoxItem Tag="direct" Content="{DynamicResource PD.AccessModeDirect}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource PD.WireLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ClaudeWireCombo" Height="34" SelectionChanged="ClaudeWireCombo_Changed">
                                        <ComboBoxItem Tag="anthropic" Content="{DynamicResource PD.WireAnthropic}" IsSelected="True"/>
                                        <ComboBoxItem Tag="chat" Content="{DynamicResource PD.WireChat}"/>
                                        <ComboBoxItem Tag="responses" Content="{DynamicResource PD.WireResponses}"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Codex Wire API -->
                            <StackPanel x:Name="CodexWirePanel">
                                <TextBlock Text="{DynamicResource PD.CodexWireLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource PD.CodexWireDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CodexWireCombo" Height="36" Margin="0,0,0,4">
                                    <ComboBoxItem Tag="responses" Content="{DynamicResource PD.WireResponsesNative}" IsSelected="True"/>
                                    <ComboBoxItem Tag="chat" Content="{DynamicResource PD.WireChat}"/>
                                    <ComboBoxItem Tag="anthropic" Content="{DynamicResource PD.WireAnthropicRouter}"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- OpenCode Npm -->
                            <StackPanel x:Name="OpenCodeFormatPanel" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource PD.OcNpmLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource PD.OcNpmDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="OcNpmCombo" IsEditable="False" Height="34" Margin="0,0,0,4">
                                    <ComboBoxItem Content="@ai-sdk/openai-compatible" IsSelected="True"/>
                                    <ComboBoxItem Content="@ai-sdk/anthropic"/>
                                    <ComboBoxItem Content="@ai-sdk/azure"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Pi Api Format -->
                            <StackPanel x:Name="PiFormatPanel" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource PD.PiApiLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource PD.PiApiDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PiApiCombo" IsEditable="False" Height="34" Margin="0,0,0,4">
                                    <ComboBoxItem Content="openai-completions" IsSelected="True"/>
                                    <ComboBoxItem Content="anthropic-messages"/>
                                    <ComboBoxItem Content="openai-responses"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- API Key / Token -->
                        <TextBlock x:Name="KeyLabel" Text="{DynamicResource PD.KeyLabelDefault}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <Grid Height="38" Margin="0,0,0,2">
                            <PasswordBox x:Name="KeyPasswordBox" Height="38" Padding="12,0,42,0" VerticalContentAlignment="Center"
                                         FontFamily="Consolas, Cascadia Code, Segoe UI"/>
                            <TextBox x:Name="KeyTextBox" Tag="sk-..." Height="38" Padding="12,0,42,0" VerticalContentAlignment="Center"
                                     FontFamily="Consolas, Cascadia Code, Segoe UI" Visibility="Collapsed"/>
                            <Button x:Name="ToggleKeyBtn" Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="36" Height="32" Margin="0,0,3,0"
                                    Click="ToggleKeyVisibility_Click" ToolTip="{DynamicResource PD.ToggleKeyTip}">
                                <Path x:Name="EyeIconPath" Data="{StaticResource IconEye}" Fill="{StaticResource TextDimBrush}"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="KeyHintText" Text="{DynamicResource PD.KeyHintDefault}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,12"/>

                        <!-- Base URL -->
                        <TextBlock x:Name="BaseUrlLabel" Text="Base URL" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource PD.BaseUrlHint}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="BaseUrlBox" Tag="https://api.example.com/v1" Margin="0,0,0,14"/>

                        <!-- Default Model & Small Fast Model -->
                        <Grid x:Name="DirectModelPanel" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="SmallFastColSpace" Width="16"/>
                                <ColumnDefinition x:Name="SmallFastCol" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource PD.DefaultModelLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="DirectFetchModelsBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,2" Height="24"
                                            Click="FetchModels_Click" ToolTip="{DynamicResource PD.FetchModelsTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloud}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DirectFetchBtnText" Text="{DynamicResource PD.FetchModelsBtn}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ComboBox x:Name="ModelCombo" IsEditable="True" Height="36"
                                          ItemsSource="{Binding FetchedModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Tag="{DynamicResource PD.ModelTag}"/>
                            </StackPanel>

                            <StackPanel x:Name="SmallFastPanel" Grid.Column="2">
                                <TextBlock Text="{DynamicResource PD.SmallFastLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SmallFastCombo" IsEditable="True" Height="36"
                                          ItemsSource="{Binding FetchedModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Tag="{DynamicResource PD.SmallFastTag}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Advanced Settings Collapsible Section (Default Hidden) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,4,0,14">
                            <StackPanel>
                                <Button x:Name="ToggleAdvancedBtn" Click="ToggleAdvanced_Click" Style="{StaticResource GhostButton}"
                                        BorderThickness="0" Background="Transparent" Padding="14,10" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="AdvancedArrowIcon" Data="{StaticResource IconChevronRight}" Fill="{StaticResource TextDimBrush}"
                                                  Width="9" Height="9" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="AdvancedArrowRotate" Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Text="{DynamicResource PD.AdvancedTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource PD.AdvancedHint}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="AdvancedCountBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource TabActiveBgBrush}" BorderBrush="{DynamicResource TabActiveBorderBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="6,1" Visibility="Collapsed">
                                            <TextBlock x:Name="AdvancedCountText" Text="" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <StackPanel x:Name="AdvancedSettingsPanel" Visibility="Collapsed" Margin="14,0,14,14">
                                    <Border Height="1" Background="#E2E8F0" Margin="0,2,0,12"/>

                                    <!-- Custom Headers Section -->
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource PD.HeadersTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{DynamicResource PD.HeadersDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Content="{DynamicResource PD.AddHeaderBtn}" Style="{StaticResource GhostButton}" Click="AddHeader_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="EmptyHeadersText" Text="{DynamicResource PD.EmptyHeaders}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8"/>
                                    <ItemsControl x:Name="HeadersItemsControl" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource PD.HeaderKeyTag}" ToolTip="{DynamicResource PD.HeaderKeyTag}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource PD.HeaderValueTag}" ToolTip="{DynamicResource PD.HeaderValueTag}"/>
                                                    <Button Grid.Column="4" Style="{StaticResource DangerButton}" Padding="0" Click="DeleteHeader_Click" ToolTip="{DynamicResource Common.Delete}">
                                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="#E2E8F0" Margin="0,4,0,12"/>

                                    <!-- Extra Options Section -->
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource PD.OptionsTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{DynamicResource PD.OptionsDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Content="{DynamicResource PD.AddOptionBtn}" Style="{StaticResource GhostButton}" Click="AddOption_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="EmptyOptionsText" Text="{DynamicResource PD.EmptyOptions}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8"/>
                                    <ItemsControl x:Name="OptionsItemsControl" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource PD.OptionKeyTag}" ToolTip="{DynamicResource PD.OptionKeyTag}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource PD.OptionValueTag}" ToolTip="{DynamicResource PD.OptionValueTag}"/>
                                                    <Button Grid.Column="4" Style="{StaticResource DangerButton}" Padding="0" Click="DeleteOption_Click" ToolTip="{DynamicResource Common.Delete}">
                                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                        <!-- Claude 4-Role Model Mapping Section -->
                        <StackPanel x:Name="ClaudeModelMappingSection" Visibility="Collapsed">
                            <!-- Header -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource PD.MappingTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{DynamicResource PD.MappingDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Click="FetchModels_Click" ToolTip="{DynamicResource PD.FetchListTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCloud}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="ClaudeFetchModelsBtnText" Text="{DynamicResource PD.FetchListBtn}" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Table Header -->
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource PD.ColRole}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource PD.ColDisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="4" Text="{DynamicResource PD.ColModel}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Grid.Column="6" Text="{DynamicResource PD.Col1m}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- 4 Fixed Mapping Rows ItemsControl -->
                            <ItemsControl x:Name="ClaudeMappingItemsControl" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Role Badge -->
                                            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                                    CornerRadius="6" Height="34" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="12" Foreground="#334155"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Display Name Box -->
                                            <TextBox Grid.Column="2" Height="34" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="{DynamicResource PD.DisplayNameTag}" ToolTip="{DynamicResource PD.DisplayNameTip}"/>

                                            <!-- Actual Model ComboBox -->
                                            <ComboBox Grid.Column="4" Height="34" IsEditable="True"
                                                      Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FetchedModels}"
                                                      SelectionChanged="ClaudeModelCombo_SelectionChanged"
                                                      Tag="{DynamicResource PD.ModelComboTag}" ToolTip="{DynamicResource PD.ModelComboTip}"/>

                                            <!-- Supports 1M CheckBox -->
                                            <CheckBox Grid.Column="6" Content="1M" IsChecked="{Binding Supports1m, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ToolTip="{DynamicResource PD.Supported1mTip}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Codex / OpenCode Models Configuration Section -->
                        <StackPanel x:Name="CodexModelsSection">
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource PD.ModelConfigTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{DynamicResource PD.ModelsDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button x:Name="FetchModelsBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="FetchModels_Click" ToolTip="{DynamicResource PD.FetchListTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloud}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="FetchModelsBtnText" Text="{DynamicResource PD.FetchListBtn}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{DynamicResource PD.AddModelBtn}" Style="{StaticResource GhostButton}" Click="AddModel_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fetched Models Temporary Pool Banner & Quick Selector -->
                            <Border x:Name="FetchedModelsBar" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCloud}" Fill="#16A34A" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FetchedModelsTitleText" Text="{DynamicResource PD.FetchedTitleFmt}" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource PD.FetchedHint}" FontSize="11" Foreground="#166534" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SelectModelToAddCombo" Grid.Column="0" Height="34" IsEditable="True"
                                                  ItemsSource="{Binding FetchedModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Tag="{DynamicResource PD.SelectModelTag}"/>
                                        <Button Grid.Column="2" Content="{DynamicResource PD.AddSelectedBtn}" Style="{StaticResource PrimaryButton}" Padding="12,4" Height="34" FontSize="12" Click="AddSelectedFetchedModel_Click"/>
                                        <Button Grid.Column="4" x:Name="AddAllFetchedBtn" Content="{DynamicResource PD.AddAllBtn}" Style="{StaticResource GhostButton}" Padding="10,4" Height="34" FontSize="12" Click="AddAllFetchedModels_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="EmptyModelsText" Text="{DynamicResource PD.EmptyModels}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,10"/>
                            <ItemsControl x:Name="ModelsItemsControl" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="›" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" IsEditable="True" Height="34"
                                                      Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FetchedModels}"
                                                       Tag="{DynamicResource PD.ModelIdTag}" ToolTip="{DynamicResource PD.ModelIdTip}"/>
                                            <TextBox Grid.Column="3" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource PD.ShowNameTag}" ToolTip="{DynamicResource PD.ShowNameTip}"/>
                                            <TextBox Grid.Column="5" Text="{Binding ContextWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource PD.ContextTag}" ToolTip="{DynamicResource PD.ContextTip}"/>
                                            <Button Grid.Column="7" Style="{StaticResource DangerButton}" Padding="0" Click="DeleteModel_Click" ToolTip="{DynamicResource PD.DeleteModelTip}">
                                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Background="#E2E8F0" Margin="0,4,0,14"/>

                        <!-- JSON / Config Preview -->
                        <TextBlock Text="{DynamicResource PD.JsonTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <TextBox x:Name="JsonPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                     Foreground="#334155" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Action Bar -->
            <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="24,12">
                <Grid>
                    <TextBlock x:Name="StatusMessageText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,210,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{DynamicResource PD.CancelBtn}" Style="{StaticResource GhostButton}" Width="80" Margin="0,0,10,0" Click="OnCancel" IsCancel="True"/>
                        <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="OnOk" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSave}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource PD.SaveBtn}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
