<Window x:Class="APISwitch.Dialogs.ProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="供应商"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="22">
        <Label Content="名称 *"/>
        <TextBox x:Name="NameBox"/>

        <CheckBox x:Name="OfficialCheck" Content="官方配置（清除第三方端点，恢复官方登录）"
                  Margin="0,12,0,0" Checked="OfficialCheck_Changed" Unchecked="OfficialCheck_Changed"/>

        <StackPanel x:Name="FieldsPanel" Margin="0,12,0,0">
            <Label x:Name="BaseUrlLabel" Content="Base URL"/>
            <TextBox x:Name="BaseUrlBox"/>

            <Label x:Name="KeyLabel" Content="Auth Token" Margin="0,10,0,3"/>
            <TextBox x:Name="KeyBox"/>

            <Label Content="模型（可选）" Margin="0,10,0,3"/>
            <TextBox x:Name="ModelBox"/>

            <StackPanel x:Name="ClaudePanel">
                <Label Content="Small / Fast 模型（可选）" Margin="0,10,0,3"/>
                <TextBox x:Name="SmallFastBox"/>
                <Label Content="额外环境变量（JSON 对象，可选，如 {&quot;ANTHROPIC_DEFAULT_SONNET_MODEL&quot;:&quot;...&quot;}）" Margin="0,10,0,3"/>
                <TextBox x:Name="ExtraEnvBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </StackPanel>

            <StackPanel x:Name="CodexPanel">
                <Label Content="Wire API" Margin="0,10,0,3"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ResponsesRadio" Content="responses" IsChecked="True" GroupName="wire" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ChatRadio" Content="chat" GroupName="wire" VerticalAlignment="Center"/>
                </StackPanel>
                <Label Content="Bearer Token（直接写入 config，可选；填写后 API Key 可留空）" Margin="0,10,0,3"/>
                <TextBox x:Name="BearerBox"/>
            </StackPanel>

            <StackPanel x:Name="OpenCodePanel">
                <Label Content="Provider ID（provider 键，如 fengwind）" Margin="0,10,0,3"/>
                <TextBox x:Name="OcIdBox"/>
                <Label Content="npm 包（一般 @ai-sdk/openai-compatible 或 @ai-sdk/anthropic 等）" Margin="0,10,0,3"/>
                <TextBox x:Name="OcNpmBox" Text="@ai-sdk/openai-compatible"/>
                <Label Content="模型配置（JSON 对象，键为模型 ID）" Margin="0,10,0,3"/>
                <TextBox x:Name="OcModelsBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Click="OnCancel" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnOk" IsDefault="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>

