<Window x:Class="APISwitch.Dialogs.PricingCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Pricing.Title}"
        Width="800" Height="680" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FC"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="ActionMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A5B4FC"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleRowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F4F7FC" BorderBrush="#CBD7EE" BorderThickness="1.2" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E9F2" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="16,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Background="#CCFBF1" Margin="0,0,8,0">
                            <TextBlock Text="$" FontSize="13" FontWeight="Bold" Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Pricing.Title}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}"
                                Click="OnCloseClick" ToolTip="{DynamicResource Usage.CloseTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主滚动工作区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,8">
                <StackPanel>

                    <!-- 1. 云端模型价格库同步卡片 -->
                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Pricing.CloudTitle}" FontSize="13.5" FontWeight="SemiBold"/>
                                    <Border Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="5" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SyncCountBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F766E" Text="—"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SyncDetailText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                <CheckBox x:Name="AutoSyncCheckBox" Content="{DynamicResource Pricing.AutoSyncCheck}" Checked="OnAutoSyncChanged" Unchecked="OnAutoSyncChanged" FontSize="12"/>
                            </StackPanel>

                            <Button x:Name="SyncNowBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="14,7" VerticalAlignment="Center" Click="OnSyncNowClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Pricing.SyncNowBtn}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2. 供应商整站倍率卡片 -->
                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Pricing.MultTitle}" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Pricing.MultDesc}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="MultProviderCombo" Grid.Column="0" IsEditable="True" Height="30" FontSize="12"
                                          ToolTip="{DynamicResource Pricing.ProviderHint}"/>
                                <TextBox x:Name="MultValueBox" Grid.Column="2" Height="30" Padding="8,4" FontSize="12"
                                         Tag="{DynamicResource Pricing.MultValuePlaceholder}"/>
                                <TextBox x:Name="MultNoteBox" Grid.Column="4" Height="30" Padding="8,4" FontSize="12"
                                         Tag="{DynamicResource Pricing.NotePlaceholder}"/>
                                <Button Grid.Column="6" Style="{StaticResource ActionMiniBtn}" Content="{DynamicResource Pricing.SaveRuleBtn}" Click="OnSaveMultiplierClick"/>
                            </Grid>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                <StackPanel>
                                    <TextBlock x:Name="MultEmptyText" Text="{DynamicResource Pricing.MultEmpty}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="8,6" HorizontalAlignment="Center"/>
                                    <ItemsControl x:Name="MultipliersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource RuleRowBtn}" Click="OnPickMultiplierRowClick">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Provider}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="#CCFBF1" CornerRadius="5" Padding="7,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MultiplierBadge}" FontSize="11" FontWeight="Bold" Foreground="#0F766E"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding NoteText}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource DangerMiniBtn}" Content="{DynamicResource Common.Delete}" Click="OnDeleteMultiplierClick" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. 供应商 × 模型 精确单价覆盖卡片 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Pricing.OverrideTitle}" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Pricing.OverrideDesc}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>

                            <!-- Row 1: 供应商范围 + 模型标识 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="OvProviderCombo" Grid.Column="0" IsEditable="True" Height="30" FontSize="12"
                                          ToolTip="{DynamicResource Pricing.OvProviderTip}"/>
                                <ComboBox x:Name="OvModelCombo" Grid.Column="2" IsEditable="True" Height="30" FontSize="12"
                                          ToolTip="{DynamicResource Pricing.OvModelTip}"/>
                            </Grid>

                            <!-- Row 2: 四维单价 ($ / 1M tokens) + 保存按钮 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OvInputBox" Grid.Column="0" Height="30" Padding="8,4" FontSize="12" Tag="{DynamicResource Pricing.InPriceTag}"/>
                                <TextBox x:Name="OvOutputBox" Grid.Column="2" Height="30" Padding="8,4" FontSize="12" Tag="{DynamicResource Pricing.OutPriceTag}"/>
                                <TextBox x:Name="OvCacheReadBox" Grid.Column="4" Height="30" Padding="8,4" FontSize="12" Tag="{DynamicResource Pricing.CrPriceTag}"/>
                                <TextBox x:Name="OvCacheWriteBox" Grid.Column="6" Height="30" Padding="8,4" FontSize="12" Tag="{DynamicResource Pricing.CwPriceTag}"/>
                                <Button Grid.Column="8" Style="{StaticResource ActionMiniBtn}" Content="{DynamicResource Pricing.SaveRuleBtn}" Click="OnSaveOverrideClick"/>
                            </Grid>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                <StackPanel>
                                    <TextBlock x:Name="OvEmptyText" Text="{DynamicResource Pricing.OverrideEmpty}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="8,6" HorizontalAlignment="Center"/>
                                    <ItemsControl x:Name="OverridesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource RuleRowBtn}" Click="OnPickOverrideRowClick">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="5" Padding="7,1.5" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProviderBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Model}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding RateSummary}" FontSize="11.5" Foreground="#0F766E" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource DangerMiniBtn}" Content="{DynamicResource Common.Delete}" Click="OnDeleteOverrideClick" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部状态提示栏 -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4E9F2" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,8">
                <Grid>
                    <TextBlock x:Name="StatusToastText" FontSize="11.5" Foreground="#0F766E" VerticalAlignment="Center" Text="{DynamicResource Pricing.FooterHint}" TextTrimming="CharacterEllipsis"/>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="18,5" FontSize="12" Content="{DynamicResource Usage.Done}" Click="OnCloseClick"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
