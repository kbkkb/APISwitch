<Window x:Class="APISwitch.Dialogs.FloatingWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APISwitch Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="WidgetMiniProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4.5"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.25" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2.25" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetIconBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetCollapsePillBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="BorderBrush" Value="#A5B4FC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetFooterBtn" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE"/>
                                <Setter Property="Foreground" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化圆角右键菜单样式 -->
        <Style x:Key="WidgetMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="4" Margin="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#0F172A"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <!-- ==================== 1. 常驻极简胶囊态（双维度 5h + 周限 + 用量 + 速率） ==================== -->
        <Border x:Name="CapsuleView"
                Visibility="Visible"
                Height="38"
                CornerRadius="19"
                Background="#FAFFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="8,0,11,0"
                Cursor="Hand"
                ToolTip="{DynamicResource Widget.CapsuleTip}"
                MouseLeftButtonDown="Capsule_MouseLeftButtonDown"
                MouseMove="Capsule_MouseMove"
                MouseLeftButtonUp="Capsule_MouseLeftButtonUp"
                MouseRightButtonUp="Widget_MouseRightButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#0F172A"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 账号首字母徽标 + 状态点 -->
                <Grid Width="23" Height="23" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="11.5">
                        <TextBlock x:Name="CapsuleInitialText" Text="A" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse x:Name="CapsuleStatusDot" Width="7" Height="7" Fill="#16A34A" Stroke="#FFFFFF" StrokeThickness="1.2"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                </Grid>

                <!-- Gemini 双维胶囊：5h · 周 -->
                <Border Margin="7,0,0,0" Padding="7,2.5" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CapsuleGemPrimaryText" Text="G —" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CapsuleGemWeekText" Text="" FontSize="10.5" FontWeight="Medium" Foreground="#0369A1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Claude/3P 双维胶囊：5h · 周 -->
                <Border Margin="5,0,0,0" Padding="7,2.5" CornerRadius="10" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CapsuleClaudePrimaryText" Text="C —" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CapsuleClaudeWeekText" Text="" FontSize="10.5" FontWeight="Medium" Foreground="#6D28D9" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Width="1" Height="15" Background="#E2E8F0" Margin="8,0" VerticalAlignment="Center"/>

                <!-- Antigravity 今日用量 + 最新速率 -->
                <Path Data="{StaticResource IconZap}" Fill="#4F46E5" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="CapsuleTokensText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <TextBlock Text="·" FontSize="11" Foreground="#94A3B8" Margin="5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CapsuleSpeedText" Text="— tok/s" FontSize="11" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center"/>

                <TextBlock Text="▴" FontSize="10" Foreground="#64748B" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ==================== 2. 展开后现代详情卡片（无关闭按钮 · 醒目收起） ==================== -->
        <Border x:Name="ExpandedView"
                Visibility="Collapsed"
                Width="372"
                CornerRadius="15"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="15,13"
                MouseRightButtonUp="Widget_MouseRightButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header: 左侧身份与内联刷新 · 右侧醒目收起胶囊（不放关闭按钮） -->
                <Grid x:Name="ExpandedHeaderGrid"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="ExpandedHeader_MouseLeftButtonDown"
                      MouseMove="ExpandedHeader_MouseMove"
                      MouseLeftButtonUp="ExpandedHeader_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpandedInitialText" Text="A" FontSize="14" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpandedEmailText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2.5,0,0" VerticalAlignment="Center">
                            <Border x:Name="ExpandedTierBadge" Padding="6,1" CornerRadius="5" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ExpandedTierText" Text="Free" FontSize="10" FontWeight="SemiBold" Foreground="#4F46E5"/>
                            </Border>
                            <TextBlock x:Name="ExpandedSyncText" Text="" FontSize="10.5" Foreground="#64748B" Margin="7,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="ExpandedRefreshBtn" Style="{StaticResource WidgetIconBtn}" Click="OnRefreshClick" ToolTip="{DynamicResource Widget.RefreshTip}" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource WidgetCollapsePillBtn}" Click="OnCollapseClick"
                            ToolTip="{DynamicResource Widget.CollapseTip}" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Widget.CollapseBtn}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- 双栏 5h + 周限 配额卡片 -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,11,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="17"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列: Gemini (5h + 周限) -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#4F46E5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Gemini" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="Gem5hBlock" Margin="0,0,0,7">
                                <Grid Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.FiveHourLabel}" FontSize="10.5" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                        <Border x:Name="Gem5hCdBadge" Background="#F1F5F9" CornerRadius="4" Padding="4,0.5" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="Gem5hCdText" Text="" FontSize="9.5" FontWeight="Medium" Foreground="#64748B"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="Gem5hPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="Gem5hBar" Style="{StaticResource WidgetMiniProgress}" Minimum="0" Maximum="1" Value="0" Foreground="#16A34A"/>
                            </StackPanel>

                            <StackPanel x:Name="GemWeekBlock">
                                <Grid Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.WeeklyLabel}" FontSize="10.5" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                        <Border x:Name="GemWeekCdBadge" Background="#F1F5F9" CornerRadius="4" Padding="4,0.5" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="GemWeekCdText" Text="" FontSize="9.5" FontWeight="Medium" Foreground="#64748B"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="GemWeekPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="GemWeekBar" Style="{StaticResource WidgetMiniProgress}" Minimum="0" Maximum="1" Value="0" Foreground="#4F46E5"/>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0" HorizontalAlignment="Center"/>

                        <!-- 右列: Claude / GPT (5h + 周限) -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#7C3AED" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Claude / GPT" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="Claude5hBlock" Margin="0,0,0,7">
                                <Grid Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.FiveHourLabel}" FontSize="10.5" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                        <Border x:Name="Claude5hCdBadge" Background="#F1F5F9" CornerRadius="4" Padding="4,0.5" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="Claude5hCdText" Text="" FontSize="9.5" FontWeight="Medium" Foreground="#64748B"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="Claude5hPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="Claude5hBar" Style="{StaticResource WidgetMiniProgress}" Minimum="0" Maximum="1" Value="0" Foreground="#16A34A"/>
                            </StackPanel>

                            <StackPanel x:Name="ClaudeWeekBlock">
                                <Grid Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.WeeklyLabel}" FontSize="10.5" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                        <Border x:Name="ClaudeWeekCdBadge" Background="#F1F5F9" CornerRadius="4" Padding="4,0.5" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="ClaudeWeekCdText" Text="" FontSize="9.5" FontWeight="Medium" Foreground="#64748B"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="ClaudeWeekPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="ClaudeWeekBar" Style="{StaticResource WidgetMiniProgress}" Minimum="0" Maximum="1" Value="0" Foreground="#7C3AED"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Antigravity 单端今日用量与速率卡 -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{DynamicResource Widget.TodayLabel}" FontSize="10" Foreground="#64748B"/>
                            <TextBlock x:Name="TodayTokensText" Text="0" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,1"/>
                            <TextBlock x:Name="TodaySubText" Text="" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="2,2,8,2"/>

                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                            <TextBlock Text="{DynamicResource Widget.SpeedLabel}" FontSize="10" Foreground="#64748B"/>
                            <TextBlock x:Name="LatestSpeedText" Text="—" FontSize="13.5" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,1"/>
                            <TextBlock x:Name="AvgSpeedSubText" Text="" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Background="#E2E8F0" Margin="2,2,8,2"/>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource Widget.ModelLabel}" FontSize="10" Foreground="#64748B"/>
                            <TextBlock x:Name="RecentModelText" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,3,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TtftSubText" Text="" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 可用模型折叠条（全宽胶囊风格） -->
                <StackPanel x:Name="ModelsSection" Visibility="Collapsed" Margin="0,0,0,9">
                    <Button Click="OnToggleModelsClick" Cursor="Hand" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ModBar" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ModBar" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="ModBar" Property="BorderBrush" Value="#CBD5E1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <TextBlock x:Name="ModelsToggleText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ModelsChevronText" Text="▸" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Button>
                    <ScrollViewer x:Name="ModelsDrawer" Visibility="Collapsed" MaxHeight="86" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl x:Name="WidgetModelsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ChipBg}" BorderBrush="{Binding ChipBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="6,2.5" Margin="0,0,5,5" ToolTip="{Binding Tooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="10.5" FontWeight="Medium" Foreground="{Binding TitleFg}" VerticalAlignment="Center"/>
                                            <Border Visibility="{Binding LevelsBadgeVisibility}" Background="{Binding BadgeBg}" CornerRadius="4" Padding="4,0.5" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LevelsBadge}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- 快捷切换 Antigravity 账号 -->
                <StackPanel x:Name="SwitcherSection">
                    <TextBlock x:Name="SwitchHeaderText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="144" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WidgetAccountsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,5.5" Margin="0,0,0,4"
                                            Background="{Binding RowBg}" BorderBrush="{Binding RowBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Email}" FontSize="11.5" FontWeight="{Binding EmailWeight}" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Email}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Border Padding="5,1" CornerRadius="4" Background="#EFF6FF" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding GemShort}" FontSize="10" FontWeight="SemiBold" Foreground="#0284C7"/>
                                                </Border>
                                                <Border Padding="5,1" CornerRadius="4" Background="#F5F3FF">
                                                    <TextBlock Text="{Binding ClaudeShort}" FontSize="10" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                                </Border>
                                            </StackPanel>

                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                <Border Visibility="{Binding CurrentBadgeVisibility}" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="5" Padding="6,2">
                                                    <TextBlock Text="{DynamicResource Widget.CurrentBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                                </Border>
                                                <Button Visibility="{Binding SwitchBtnVisibility}" Click="OnSwitchAccountClick" Padding="8,2.5" FontSize="10.5" FontWeight="Medium"
                                                        Cursor="Hand" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="SwBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="{DynamicResource Widget.SwitchBtn}" FontSize="10.5" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="SwBd" Property="Background" Value="#EEF2FF"/>
                                                                    <Setter TargetName="SwBd" Property="BorderBrush" Value="#818CF8"/>
                                                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- 底部操作栏：右键关闭提示 + 用量监控/主界面直达 -->
                <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Text="{DynamicResource Widget.RightClickHint}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource WidgetFooterBtn}" Click="OnOpenUsageClick" Margin="0,0,6,0" ToolTip="{DynamicResource Widget.OpenUsageTip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconZap}" Fill="#4F46E5" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Widget.UsageBtn}" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WidgetFooterBtn}" Click="OnOpenMainClick" ToolTip="{DynamicResource Widget.OpenMainTip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconExternal}" Fill="#475569" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Widget.MainBtn}" FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
