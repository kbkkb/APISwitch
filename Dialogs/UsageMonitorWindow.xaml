<Window x:Class="APISwitch.Dialogs.UsageMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:APISwitch.Dialogs"
        Title="{DynamicResource Usage.Title}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1180" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FC"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 顶栏主视图胶囊导航 -->
        <Style x:Key="NavTabRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6.5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 时间快速筛选微胶囊 -->
        <Style x:Key="QuickPillRadio" TargetType="RadioButton" BasedOn="{StaticResource NavTabRadio}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- 可点击排序表头按钮 -->
        <Style x:Key="SortColBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行头部整行可点击 -->
        <Style x:Key="RowHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部工具栏小按钮 -->
        <Style x:Key="ToolbarMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 受支持客户端图标快捷筛选胶囊 -->
        <Style x:Key="ClientFilterPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,5,3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#F8FAFC" BorderBrush="#E5EAF2" BorderThickness="1"
                                CornerRadius="7" Padding="8,3.5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#4338CA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 虚拟化列表 -->
        <Style x:Key="VListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.CacheLength" Value="1,2"/>
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表行悬停底纹 -->
        <Style x:Key="FlatRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 模型详情富悬浮卡片（展示模型全称、供应商、价格来源、输入/输出/缓存单价与当前行消耗） -->
        <Style x:Key="ModelHoverTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Margin="10" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="10" Padding="13,11" MinWidth="320" MaxWidth="430" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="4" Opacity="0.13"/>
                            </Border.Effect>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <!-- 1. 模型全称 + 价格来源徽章 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ModelTitle}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RawModelSubtitle}" FontSize="10.5" Foreground="#94A3B8" Margin="0,1.5,0,0"
                                               Visibility="{Binding RawSubtitleVisibility}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{Binding SourceBadgeBg}" BorderBrush="{Binding SourceBadgeBorder}"
                                        BorderThickness="1" CornerRadius="5" Padding="6.5,2" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SourceBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding SourceBadgeFg}"/>
                                </Border>
                            </Grid>

                            <!-- 2. 模型供应商 -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Usage.TipProvider}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProviderDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- 3. 四维单价矩阵 ($ / 1M Tokens) -->
                            <Border Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="7" Padding="10,7.5" Margin="0,8,0,8">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Usage.TipUnitPrices}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Usage.TipInputRate}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InputRateText}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="0" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Usage.TipOutputRate}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OutputRateText}" FontSize="11.5" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Grid.Row="2" Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Usage.TipCacheReadRate}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CacheReadRateText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Usage.TipCacheWriteRate}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CacheWriteRateText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. 本行实际用量与等比消耗摘要 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RowBreakdownText}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding RowCostSummaryText}" FontSize="11" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F6F8FC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== 顶栏：品牌标题 + 5 主视图导航 + 工具按钮 ==================== -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="16,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：标题 + 主导航胶囊 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="26" Height="26" CornerRadius="7" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1" Margin="0,0,9,0">
                            <Path Data="{StaticResource IconZap}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Usage.Title}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Border Background="#F1F5F9" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabProvidersRadio" Style="{StaticResource NavTabRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabProviders}" Checked="OnTabProvidersChecked" IsChecked="True"/>
                                <RadioButton x:Name="TabAntigravityRadio" Style="{StaticResource NavTabRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabAntigravity}" Checked="OnTabAntigravityChecked" Margin="2,0,0,0"/>
                                <RadioButton x:Name="TabAgentsRadio" Style="{StaticResource NavTabRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabAgents}" Checked="OnTabAgentsChecked" Margin="2,0,0,0"/>
                                <RadioButton x:Name="TabModelsRadio" Style="{StaticResource NavTabRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabModels}" Checked="OnTabModelsChecked" Margin="2,0,0,0"/>
                                <RadioButton x:Name="TabCallsRadio" Style="{StaticResource NavTabRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabCalls}" Checked="OnTabCallsChecked" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 右：全局操作 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="PricingBtn" Style="{StaticResource ToolbarMiniBtn}" ToolTip="{DynamicResource Usage.PricingTip}" Click="OnOpenPricingCenterClick" Margin="0,0,6,0"
                                Background="#F0FDFA" BorderBrush="#CCFBF1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="$" FontSize="11.5" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Usage.PricingBtn}" Foreground="#0F766E" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshBtn" Style="{StaticResource ToolbarMiniBtn}" ToolTip="{DynamicResource Usage.RefreshTip}" Click="OnRefreshNowClick" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Fill="#475569" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Usage.RefreshBtn}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportBtn" Style="{StaticResource ToolbarMiniBtn}" ToolTip="{DynamicResource Usage.ExportCsvTip}" Click="OnExportCsvClick" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSave}" Fill="#475569" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Usage.ExportCsvBtn}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BackfillBtn" Style="{StaticResource ToolbarMiniBtn}" Click="OnBackfillClick" Margin="0,0,6,0" ToolTip="{DynamicResource Usage.BackfillConfirmTitle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconImport}" Fill="#475569" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Usage.BackfillBtn}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HelpBtn" Style="{StaticResource ToolbarMiniBtn}" Width="28" Padding="0" Click="OnHelpClick" ToolTip="{DynamicResource Usage.Note}" Margin="0,0,4,0">
                            <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Border Width="1" Height="16" Background="#E2E8F0" Margin="4,0"/>
                        <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionBtn}" Tag="{StaticResource IconMax}"
                                Click="OnToggleMaximize" ToolTip="{DynamicResource Usage.MaxTip}"/>
                        <Button Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}"
                                Click="OnClose" ToolTip="{DynamicResource Usage.CloseTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 主工作台 ==================== -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. 紧凑筛选控制栏（单行时间胶囊 + 自定义时间弹窗 + 搜索 + 客户端快筛） -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="11" Padding="12,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：快捷时间胶囊 + 自定义区间浮窗按钮 + 聚焦单日胶囊 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#F1F5F9" CornerRadius="7.5" Padding="2.5">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Quick1DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1D}" Checked="OnQuickRangeChecked" Tag="1"/>
                                        <RadioButton x:Name="Quick7DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1W}" Checked="OnQuickRangeChecked" Tag="7" Margin="2,0,0,0"/>
                                        <RadioButton x:Name="Quick30DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick30D}" Checked="OnQuickRangeChecked" Tag="30" Margin="2,0,0,0"/>
                                        <RadioButton x:Name="Quick180DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick180D}" Checked="OnQuickRangeChecked" Tag="180" Margin="2,0,0,0"/>
                                        <RadioButton x:Name="Quick365DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1Y}" Checked="OnQuickRangeChecked" Tag="365" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 自定义日期区间弹窗触发胶囊 -->
                                <Grid Margin="8,0,0,0">
                                    <Button x:Name="CustomRangeBtn" Style="{StaticResource ToolbarMiniBtn}" Height="29" Padding="10,0"
                                            Click="OnToggleCustomRangePopupClick" ToolTip="{DynamicResource Usage.PickerTip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCalendar}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="RangeSummaryText" Text="—" FontSize="11.5" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <TextBlock Text="▾" FontSize="9.5" Foreground="#94A3B8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Popup x:Name="CustomRangePopup" PlacementTarget="{Binding ElementName=CustomRangeBtn}" Placement="Bottom"
                                           VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="4" Opacity="0.12"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Usage.CustomRangeBtn}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Usage.From}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5" Foreground="#64748B"/>
                                                    <local:DateTimePickerBox x:Name="StartPicker" Width="152" ValueChanged="OnRangeFieldEdited"/>
                                                    <TextBlock Text="{DynamicResource Usage.To}" VerticalAlignment="Center" Margin="10,0,6,0" FontSize="11.5" Foreground="#64748B"/>
                                                    <local:DateTimePickerBox x:Name="EndPicker" Width="152" ValueChanged="OnRangeFieldEdited"/>
                                                    <Button Content="{DynamicResource Usage.Apply}" Style="{StaticResource PrimaryButton}" Padding="14,5.5" FontSize="12" Margin="10,0,0,0" Click="OnApplyCustomRangePopup"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Button x:Name="FocusedDayChip" Style="{StaticResource ToolbarMiniBtn}" Height="28" Margin="8,0,0,0"
                                        Click="OnClearFocusedDayClick" Visibility="Collapsed"
                                        Background="#EEF2FF" BorderBrush="#C7D2FE" Foreground="#4338CA"/>
                            </StackPanel>

                            <!-- 右：检索框 + 重置筛选 + 展开/收起全部 -->
                            <StackPanel x:Name="TokenFilterStrip" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox" Width="220" Height="29" Padding="10,3" FontSize="12"
                                         Background="#F8FAFC" BorderBrush="#E2E8F0"
                                         Tag="{DynamicResource Usage.SearchPlaceholder}" TextChanged="OnSearchTextChanged"/>
                                <Button x:Name="ClearFilterBtn" Style="{StaticResource ToolbarMiniBtn}" Height="29" Margin="6,0,0,0"
                                        Content="{DynamicResource Usage.ClearFilterBtn}" Click="OnClearFiltersClick" Visibility="Collapsed"/>
                                <Button x:Name="ExpandCollapseAllBtn" Style="{StaticResource ToolbarMiniBtn}" Height="29" Margin="6,0,0,0"
                                        Content="{DynamicResource Usage.ExpandAllBtn}" Click="OnToggleExpandAllClick"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ClientFilterDivider" Height="1" Background="#F1F5F9" Margin="0,7,0,6"/>

                        <!-- 客户端快捷筛选行（「反重力明细」专页自动隐藏） -->
                        <ItemsControl x:Name="ClientFilterList" Margin="0,0,0,-3" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ClientFilterPill}"
                                            Click="OnClientPillClick"
                                            Opacity="{Binding PillOpacity}"
                                            ToolTip="{Binding TooltipText}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding ImageSource}" Width="12.5" Height="12.5"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding ImageVisibility}"
                                                   VerticalAlignment="Center"/>
                                            <Path Data="{Binding IconGeometry}" Fill="{Binding IconBrush}"
                                                  Width="12.5" Height="12.5" Stretch="Uniform"
                                                  Visibility="{Binding PathVisibility}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Margin="5,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 2. Stripe / Vercel 风格：单卡竖线分隔核心指标带 + 真实连续日历趋势图 -->
                <StackPanel x:Name="TokenSummarySection" Grid.Row="1" Margin="0,9,0,0">

                    <!-- 单卡 6 格分隔指标带（克制配色，对齐基线） -->
                    <Border Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="11" Padding="0,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="0.92*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1) 等比价值（置首核心账单指标） -->
                            <StackPanel Grid.Column="0" Margin="16,0,12,0">
                                <TextBlock Text="{DynamicResource Usage.EstCost}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                <TextBlock x:Name="EstCostText" Text="$0.00" FontSize="21" FontWeight="Bold" Foreground="#0F766E" Margin="0,4,0,2"/>
                                <TextBlock x:Name="EstCostSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#EEF2F7" Margin="0,3"/>

                            <!-- 2) 总 Token -->
                            <StackPanel Grid.Column="2" Margin="15,0,12,0">
                                <TextBlock Text="{DynamicResource Usage.TotalTokens}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                <TextBlock x:Name="TotalTokensText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,2"/>
                                <TextBlock x:Name="TotalSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#EEF2F7" Margin="0,3"/>

                            <!-- 3) 输入 Token -->
                            <StackPanel Grid.Column="4" Margin="15,0,12,0">
                                <TextBlock Text="{DynamicResource Usage.InputTokens}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                <TextBlock x:Name="InTokensText" Text="0" FontSize="19.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,5,0,2"/>
                                <TextBlock x:Name="InSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="5" Background="#EEF2F7" Margin="0,3"/>

                            <!-- 4) 输出 Token -->
                            <StackPanel Grid.Column="6" Margin="15,0,12,0">
                                <TextBlock Text="{DynamicResource Usage.OutputTokens}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                <TextBlock x:Name="OutTokensText" Text="0" FontSize="19.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,5,0,2"/>
                                <TextBlock x:Name="OutSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="7" Background="#EEF2F7" Margin="0,3"/>

                            <!-- 5) 请求数 -->
                            <StackPanel Grid.Column="8" Margin="15,0,12,0">
                                <TextBlock Text="{DynamicResource Usage.Requests}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                <TextBlock x:Name="RequestsText" Text="0" FontSize="19.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,5,0,2"/>
                                <TextBlock x:Name="ReqSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="9" Background="#EEF2F7" Margin="0,3"/>

                            <!-- 6) 缓存命中率 -->
                            <StackPanel Grid.Column="10" Margin="15,0,14,0">
                                <TextBlock Text="{DynamicResource Usage.CacheHitRate}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                <TextBlock x:Name="CacheHitText" Text="—" FontSize="19.5" FontWeight="SemiBold" Foreground="#4F46E5" Margin="0,5,0,2"/>
                                <TextBlock x:Name="CacheHitDetailText" Text="" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 可折叠趋势图卡片 -->
                    <Border Margin="0,9,0,0" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="11" Padding="14,9,14,8">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Usage.TrendTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                    <StackPanel x:Name="BarLegendPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#C7D2FE" Margin="14,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Usage.LegendIn}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#4F46E5" Margin="10,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Usage.LegendOut}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel x:Name="HeatmapLegendPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Usage.HeatmapLess}" FontSize="10" Foreground="#94A3B8" Margin="14,0,4,0" VerticalAlignment="Center"/>
                                        <Border Width="9" Height="9" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Margin="1.5,0"/>
                                        <Border Width="9" Height="9" Background="#C7D2FE" CornerRadius="2" Margin="1.5,0"/>
                                        <Border Width="9" Height="9" Background="#818CF8" CornerRadius="2" Margin="1.5,0"/>
                                        <Border Width="9" Height="9" Background="#6366F1" CornerRadius="2" Margin="1.5,0"/>
                                        <Border Width="9" Height="9" Background="#4338CA" CornerRadius="2" Margin="1.5,0"/>
                                        <TextBlock Text="{DynamicResource Usage.HeatmapMore}" FontSize="10" Foreground="#94A3B8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="ClientMixPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="MixBarLabelText" Text="{DynamicResource Usage.ClientMixLabel}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border Background="#F1F5F9" CornerRadius="3.5" ClipToBounds="True" Height="7" Width="170" VerticalAlignment="Center">
                                            <StackPanel x:Name="ClientMixBar" Orientation="Horizontal"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Background="#F1F5F9" CornerRadius="6.5" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ChartModeBarRadio" Style="{StaticResource QuickPillRadio}" GroupName="ChartMode" Content="{DynamicResource Usage.ChartModeBar}" Checked="OnChartModeChanged" Tag="bar" Padding="8,2" FontSize="10.5" IsChecked="True"/>
                                            <RadioButton x:Name="ChartModeHeatmapRadio" Style="{StaticResource QuickPillRadio}" GroupName="ChartMode" Content="{DynamicResource Usage.ChartModeHeatmap}" Checked="OnChartModeChanged" Tag="heatmap" Padding="8,2" FontSize="10.5"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="ToggleChartBtn" Style="{StaticResource ToolbarMiniBtn}" Width="24" Height="22" Padding="0" Margin="6,0,0,0"
                                            Content="▴" FontSize="10" Foreground="#64748B" Click="OnToggleChartVisibilityClick" ToolTip="{DynamicResource Usage.ToggleChartTip}"/>
                                </StackPanel>
                            </Grid>

                            <Canvas x:Name="TrendCanvas" Height="106" Margin="0,6,0,0" ClipToBounds="True" SizeChanged="OnChartSizeChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. 主数据明细区（可点击列排序 + 树形缩进引导线 + 克制单色阶） -->
                <Grid Grid.Row="2" Margin="0,9,0,0">

                    <!-- 面板 1：供应商明细 -->
                    <Border x:Name="ProvidersPanel" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="14,0,22,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="138"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Usage.ColName}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{DynamicResource Usage.ColShare}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Style="{StaticResource SortColBtn}" Tag="reqs" Click="OnSortColumnClick">
                                        <TextBlock x:Name="ProvSortReqsText" Text="{DynamicResource Usage.ColReqs}"/>
                                    </Button>
                                    <TextBlock Grid.Column="5" Text="{DynamicResource Usage.ColInOut}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <Button Grid.Column="6" Style="{StaticResource SortColBtn}" Tag="cache" Click="OnSortColumnClick">
                                        <TextBlock x:Name="ProvSortCacheText" Text="{DynamicResource Usage.ColCacheHit}"/>
                                    </Button>
                                    <Button Grid.Column="7" Style="{StaticResource SortColBtn}" Tag="cost" Click="OnSortColumnClick">
                                        <TextBlock x:Name="ProvSortCostText" Text="{DynamicResource Usage.ColCost}"/>
                                    </Button>
                                    <Button Grid.Column="8" Style="{StaticResource SortColBtn}" Tag="total" Click="OnSortColumnClick">
                                        <TextBlock x:Name="ProvSortTotalText" Text="{DynamicResource Usage.ColTotal}" Foreground="#0F172A"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ListBox x:Name="ProvidersList" Grid.Row="1" Style="{StaticResource VListBox}" Padding="6,3">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="8,2">
                                            <StackPanel>
                                                <Button Style="{StaticResource RowHeaderBtn}" Click="OnToggleProviderExpand" ToolTip="{DynamicResource Usage.ExpandTip}">
                                                    <Grid Height="38">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="54"/>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="138"/>
                                                            <ColumnDefinition Width="74"/>
                                                            <ColumnDefinition Width="92"/>
                                                            <ColumnDefinition Width="92"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Data="{StaticResource IconChevronRight}" Fill="#94A3B8" Width="9.5" Height="9.5" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform><RotateTransform Angle="{Binding ChevronAngle}"/></Path.RenderTransform>
                                                        </Path>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="5.5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ModelCountText}" FontSize="10" FontWeight="Medium" Foreground="#64748B"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Height="5" CornerRadius="2.5" Background="#F1F5F9" VerticalAlignment="Center" ClipToBounds="True">
                                                            <Border Width="{Binding BarWidth}" Height="5" CornerRadius="2.5" Background="#4F46E5" HorizontalAlignment="Left"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding ShareText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,4,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ReqNumText}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding InOutText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="4.5" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CacheText}" FontSize="11" FontWeight="Medium" Foreground="#475569"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="7" Text="{Binding CostText}" FontSize="12" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="8" Text="{Binding TotalText}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextAlignment="Right"/>
                                                    </Grid>
                                                </Button>
                                                <!-- 子模型缩进树（带左侧垂直引导线） -->
                                                <Border Visibility="{Binding ModelsVisibility}" BorderBrush="#E2E8F0" BorderThickness="2,0,0,0" Margin="9,0,0,5" Padding="13,0,0,0">
                                                    <ItemsControl ItemsSource="{Binding Models}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Height="28">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="140"/>
                                                                        <ColumnDefinition Width="54"/>
                                                                        <ColumnDefinition Width="78"/>
                                                                        <ColumnDefinition Width="138"/>
                                                                        <ColumnDefinition Width="74"/>
                                                                        <ColumnDefinition Width="92"/>
                                                                        <ColumnDefinition Width="92"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="Transparent" Margin="2,0,8,0"
                                                                            ToolTipService.InitialShowDelay="140" ToolTipService.BetweenShowDelay="60" ToolTipService.ShowDuration="25000">
                                                                        <Border.ToolTip>
                                                                            <ToolTip Style="{StaticResource ModelHoverTipStyle}" Content="{Binding HoverCard}"/>
                                                                        </Border.ToolTip>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1" Height="4" CornerRadius="2" Background="#F1F5F9" VerticalAlignment="Center" ClipToBounds="True">
                                                                        <Border Width="{Binding BarWidth}" Height="4" CornerRadius="2" Background="#A5B4FC" HorizontalAlignment="Left"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextAlignment="Right" Padding="0,0,4,0"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding ReqNumText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding InOutText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextAlignment="Right"/>
                                                                    <TextBlock Grid.Column="5" Text="{Binding CacheText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                                                    <TextBlock Grid.Column="6" Text="{Binding CostText}" FontSize="11.5" FontWeight="Medium" Foreground="#0F766E" VerticalAlignment="Center" TextAlignment="Right"/>
                                                                    <TextBlock Grid.Column="7" Text="{Binding TotalText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" TextAlignment="Right"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 面板 1B：反重力明细 -->
                    <Border x:Name="AntigravityPanel" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="11" Visibility="Collapsed" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 顶部多账号分布速览带 + 额度与损耗透视入口 -->
                            <Border Grid.Row="0" Background="#FAFBFD" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="14,8,14,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/antigravity.png" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AgAccountsSummaryText" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="AgAccountChipsList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6.5" Padding="8,3" Margin="6,0,0,0"
                                                        Cursor="Hand" MouseLeftButtonUp="OnAgChipMouseUp" ToolTip="{DynamicResource Usage.AgRowDetailTip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6.5" Height="6.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ShortLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ShareText}" FontSize="10.5" Foreground="#64748B" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="·" FontSize="10.5" Foreground="#CBD5E1" Margin="4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CostText}" FontSize="10.5" Foreground="#0F766E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="AgInsightsBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="29" Padding="12,0" FontSize="11.5"
                                            Click="OnOpenAgQuotaInsightsClick" ToolTip="{DynamicResource Usage.AgInsightsTip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconZap}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Usage.AgInsightsBtn}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="14,0,22,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Usage.ColAgAccount}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{DynamicResource Usage.ColShare}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Style="{StaticResource SortColBtn}" Tag="reqs" Click="OnSortColumnClick">
                                        <TextBlock x:Name="AgSortReqsText" Text="{DynamicResource Usage.ColReqs}"/>
                                    </Button>
                                    <TextBlock Grid.Column="5" Text="{DynamicResource Usage.ColInOut}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <Button Grid.Column="6" Style="{StaticResource SortColBtn}" Tag="cache" Click="OnSortColumnClick">
                                        <TextBlock x:Name="AgSortCacheText" Text="{DynamicResource Usage.ColCacheHit}"/>
                                    </Button>
                                    <Button Grid.Column="7" Style="{StaticResource SortColBtn}" Tag="cost" Click="OnSortColumnClick">
                                        <TextBlock x:Name="AgSortCostText" Text="{DynamicResource Usage.ColCost}"/>
                                    </Button>
                                    <Button Grid.Column="8" Style="{StaticResource SortColBtn}" Tag="total" Click="OnSortColumnClick">
                                        <TextBlock x:Name="AgSortTotalText" Text="{DynamicResource Usage.ColTotal}" Foreground="#0F172A"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ListBox x:Name="AntigravityList" Grid.Row="2" Style="{StaticResource VListBox}" Padding="6,3">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="8,2">
                                            <StackPanel>
                                                <Grid Height="40">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
