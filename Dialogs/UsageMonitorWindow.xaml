                    <Border x:Name="EmptyOverlay" Background="#FFFFFF" BorderBrush="#E4E9F2" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Path Data="{StaticResource IconZap}" Fill="#C7D2FE" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Usage.NoData}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="{DynamicResource Usage.NoDataTip}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 极简单行底栏 -->
                <Grid Grid.Row="3" Margin="2,6,2,0">
                    <TextBlock Text="{DynamicResource Usage.FooterHint}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FooterStatusText" HorizontalAlignment="Right" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
