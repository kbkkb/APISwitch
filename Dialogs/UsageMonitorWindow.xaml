                                                <TextBlock Grid.Column="4" Text="{Binding InText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding OutText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="{Binding CostText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="8" Text="{Binding CacheText}" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="9" Text="{Binding SpeedText}" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="10" Text="{Binding TtftText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 空数据遮罩 -->
                    <Border x:Name="EmptyOverlay" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="11" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Path Data="{StaticResource IconZap}" Fill="#CBD5E1" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Usage.NoData}" FontSize="14" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="{DynamicResource Usage.NoDataTip}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. 底栏摘要 -->
                <Grid Grid.Row="3" Margin="2,6,2,0">
                    <TextBlock Text="{DynamicResource Usage.FooterHint}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FooterStatusText" HorizontalAlignment="Right" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
