<Window x:Class="APISwitch.Dialogs.UsageMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:APISwitch.Dialogs"
        Title="{DynamicResource Usage.Title}"
        Width="1020" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 分段式切换按钮（快速时间范围 / 视图 Tab） -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 供应商卡片头部整行可点击（展开/收起模型明细） -->
        <Style x:Key="RowHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 虚拟化列表（容器回收）：大列表只实例化可视区行，滚动/切换不卡顿 -->
        <Style x:Key="VListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.CacheLength" Value="1,2"/>
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}" BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconZap}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Usage.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="{DynamicResource Usage.CloseTip}"/>
                </Grid>
            </Border>

            <!-- 主内容 -->
            <Grid Grid.Row="1" Margin="20,14,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具栏：快速时间范围 + 自定义区间 -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2,1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Quick1DRadio" Style="{StaticResource SegRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1D}" Checked="OnQuickRangeChecked" Tag="1"/>
                                <RadioButton x:Name="Quick7DRadio" Style="{StaticResource SegRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1W}" Checked="OnQuickRangeChecked" Tag="7"/>
                                <RadioButton x:Name="Quick30DRadio" Style="{StaticResource SegRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick30D}" Checked="OnQuickRangeChecked" Tag="30"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Usage.From}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <local:DateTimePickerBox x:Name="StartPicker" Width="158" ValueChanged="OnRangeFieldEdited"/>
                            <TextBlock Text="{DynamicResource Usage.To}" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <local:DateTimePickerBox x:Name="EndPicker" Width="158" ValueChanged="OnRangeFieldEdited"/>
                            <Button Content="{DynamicResource Usage.Apply}" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="12,0,0,0" Click="OnApplyRange"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 汇总卡片 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="7" Background="#EEF2FF">
                                    <Path Data="{StaticResource IconZap}" Fill="#4F46E5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Usage.TotalTokens}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TotalTokensText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#4F46E5" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="7" Background="#E0F2FE">
                                    <Path Data="{StaticResource IconImport}" Fill="#0369A1" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Usage.InputTokens}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="InTokensText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#0369A1" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="7" Background="#DCFCE7">
                                    <Path Data="{StaticResource IconUpload}" Fill="#059669" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Usage.OutputTokens}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="OutTokensText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#059669" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="7" Background="#FEF3C7">
                                    <Path Data="{StaticResource IconRefresh}" Fill="#D97706" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Usage.Requests}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="RequestsText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#D97706" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 缓存命中率（速度与首字属单次调用维度，放在调用明细列，不在顶部汇总） -->
                    <Border Grid.Column="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="7" Background="#EDE9FE">
                                    <Path Data="{StaticResource IconZap}" Fill="#7C3AED" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Usage.CacheHitRate}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CacheHitText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#7C3AED" Margin="0,7,0,0"/>
                            <TextBlock x:Name="CacheHitDetailText" Text="" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 每日趋势图 -->
                <Border Grid.Row="2" Margin="0,12,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10,14,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Usage.TrendTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="#C7D2FE" Margin="16,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Usage.LegendIn}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="#6366F1" Margin="12,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Usage.LegendOut}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Canvas x:Name="TrendCanvas" Height="128" Margin="0,6,0,0" ClipToBounds="True" SizeChanged="OnChartSizeChanged"/>
                    </StackPanel>
                </Border>

                <!-- 视图切换 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                    <RadioButton x:Name="TabProvidersRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabProviders}" Checked="OnTabProvidersChecked" IsChecked="True"/>
                    <RadioButton x:Name="TabAgentsRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabAgents}" Checked="OnTabAgentsChecked" Margin="4,0,0,0"/>
                    <RadioButton x:Name="TabModelsRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabModels}" Checked="OnTabModelsChecked" Margin="4,0,0,0"/>
                    <RadioButton x:Name="TabCallsRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabCalls}" Checked="OnTabCallsChecked" Margin="4,0,0,0"/>
                    <TextBlock x:Name="RangeSummaryText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,2,0,0"/>
                </StackPanel>

                <!-- 视图内容（三面板） -->
                <Grid Grid.Row="4" Margin="0,10,0,0" Background="Transparent">

                    <!-- 面板 1：供应商下钻 -->
                    <ListBox x:Name="ProvidersPanel" Style="{StaticResource VListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,4,12,4" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Button Style="{StaticResource RowHeaderBtn}" Click="OnToggleProviderExpand" ToolTip="{DynamicResource Usage.ExpandTip}">
                                                    <Grid Height="36" Margin="2,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="86"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Data="{StaticResource IconChevronRight}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="{Binding ChevronAngle}"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                            <TextBlock Text="{Binding ModelCountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,2,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Height="7" CornerRadius="3.5" Background="#EEF2FF" VerticalAlignment="Center">
                                                            <Border Width="{Binding BarWidth}" Height="7" CornerRadius="3.5" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding ShareText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ReqText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding InOutText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding CacheText}" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding TotalText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Button>
                                                <ItemsControl ItemsSource="{Binding Models}" Visibility="{Binding ModelsVisibility}" Margin="8,2,6,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="26">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="170"/>
                                                                    <ColumnDefinition Width="44"/>
                                                                    <ColumnDefinition Width="76"/>
                                                                    <ColumnDefinition Width="130"/>
                                                                    <ColumnDefinition Width="78"/>
                                                                    <ColumnDefinition Width="86"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Height="1" VerticalAlignment="Bottom" Background="#F1F5F9" Margin="0,0,10,0"/>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0,0,0" ToolTip="{Binding Name}"/>
                                                                <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#EEF2FF" VerticalAlignment="Center">
                                                                    <Border Width="{Binding BarWidth}" Height="5" CornerRadius="2.5" Background="#A5B4FC" HorizontalAlignment="Left"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding ReqText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding InOutText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="5" Text="{Binding CacheText}" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" TextAlignment="Right"/>
                                                                <TextBlock Grid.Column="6" Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 面板 2：客户端汇总 -->
                    <ListBox x:Name="AgentsPanel" Style="{StaticResource VListBox}" Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,6,12,6" Margin="0,0,0,8">
                                            <Grid Height="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="86"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding AgentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Height="7" CornerRadius="3.5" Background="#EEF2FF" VerticalAlignment="Center">
                                                    <Border Width="{Binding BarWidth}" Height="7" CornerRadius="3.5" Background="{Binding AgentBrush}" HorizontalAlignment="Left"/>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding ShareText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ReqText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding InOutText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding TotalText}" FontSize="13" FontWeight="Bold" Foreground="{Binding AgentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 面板 3：模型汇总（跨供应商合并同模型） -->
                    <ListBox x:Name="ModelsPanel" Style="{StaticResource VListBox}" Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,4,12,4" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Button Style="{StaticResource RowHeaderBtn}" Click="OnToggleModelExpand" ToolTip="{DynamicResource Usage.ExpandTip}">
                                            <Grid Height="36" Margin="2,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="86"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Data="{StaticResource IconChevronRight}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="{Binding ChevronAngle}"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                    <TextBlock Text="{Binding ProviderCountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,2,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Height="7" CornerRadius="3.5" Background="#EEF2FF" VerticalAlignment="Center">
                                                    <Border Width="{Binding BarWidth}" Height="7" CornerRadius="3.5" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left"/>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding ShareText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ReqText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding InOutText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding CacheText}" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="{Binding TotalText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Providers}" Visibility="{Binding ProvidersVisibility}" Margin="8,2,6,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="86"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Height="1" VerticalAlignment="Bottom" Background="#F1F5F9" Margin="0,0,10,0"/>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                            <TextBlock Text="{Binding NameText}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding NameText}"/>
                                                            <TextBlock Text="{Binding RawModelText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding RawModel}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#EEF2FF" VerticalAlignment="Center">
                                                            <Border Width="{Binding BarWidth}" Height="5" CornerRadius="2.5" Background="#A5B4FC" HorizontalAlignment="Left"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ReqText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding InOutText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding CacheText}" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 面板 4：调用明细 -->
                    <Grid x:Name="CallsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,0" Margin="0,0,0,6">
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Usage.ColTime}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Usage.ColAgent}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Usage.ColProvider}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource Usage.ColModel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{DynamicResource Usage.ColIn}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{DynamicResource Usage.ColOut}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="{DynamicResource Usage.ColTotal}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="{DynamicResource Usage.ColCache}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="8" Text="{DynamicResource Usage.ColSpeed}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="9" Text="{DynamicResource Usage.ColTtft}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ListBox x:Name="CallsList" Grid.Row="1" Style="{StaticResource VListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{Binding AgentBg}" CornerRadius="5" Padding="7,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AgentName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding AgentBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Provider}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Provider}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Model}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Model}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding InText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="{Binding OutText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="6" Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="7" Text="{Binding CacheText}" FontSize="12" Foreground="#7C3AED" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="8" Text="{Binding SpeedText}" FontSize="12" Foreground="#DC2626" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="9" Text="{Binding TtftText}" FontSize="12" Foreground="#CA8A04" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 空数据遮罩 -->
                    <Border x:Name="EmptyOverlay" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Path Data="{StaticResource IconZap}" Fill="#C7D2FE" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Usage.NoData}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="{DynamicResource Usage.NoDataTip}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 说明 + 回填入 -->
                <Grid Grid.Row="5" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Usage.Note}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BackfillBtn" Style="{StaticResource GhostButton}" Content="{DynamicResource Usage.BackfillBtn}" Click="OnBackfillClick" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
