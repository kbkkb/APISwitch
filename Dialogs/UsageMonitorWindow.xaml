<Window x:Class="APISwitch.Dialogs.UsageMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:APISwitch.Dialogs"
        Title="{DynamicResource Usage.Title}"
        Width="1080" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FC"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 分段胶囊切换（白色悬浮激活块，轻盈现代） -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6.5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5FB"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D6DFEE"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 时间快速筛选微胶囊 -->
        <Style x:Key="QuickPillRadio" TargetType="RadioButton" BasedOn="{StaticResource SegRadio}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- 行头部整行可点击（展开/收起明细） -->
        <Style x:Key="RowHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部精简工具小按钮 -->
        <Style x:Key="ToolbarMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 受支持客户端图标快捷筛选胶囊 -->
        <Style x:Key="ClientFilterPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,5,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="8,4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 虚拟化列表（容器回收） -->
        <Style x:Key="VListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.CacheLength" Value="1,2"/>
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI 统一白卡 -->
        <Style x:Key="KpiCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="13,9"/>
        </Style>

        <!-- 列表行柔和悬停容器 -->
        <Style x:Key="FlatRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F4F7FC" BorderBrush="#CBD7EE" BorderThickness="1.2" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E9F2" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="16,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Background="#EEF2FF" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconZap}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Usage.Title}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RangeSummaryText" FontSize="11" Foreground="#475569" Text="—"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="RefreshBtn" Style="{StaticResource ToolbarMiniBtn}" ToolTip="{DynamicResource Usage.RefreshTip}" Click="OnRefreshNowClick" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Usage.RefreshBtn}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportBtn" Style="{StaticResource ToolbarMiniBtn}" ToolTip="{DynamicResource Usage.ExportCsvTip}" Click="OnExportCsvClick" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSave}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Usage.ExportCsvBtn}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BackfillBtn" Style="{StaticResource ToolbarMiniBtn}" Click="OnBackfillClick" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconImport}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Usage.BackfillBtn}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HelpBtn" Style="{StaticResource ToolbarMiniBtn}" Width="28" Padding="0" Click="OnHelpClick" ToolTip="{DynamicResource Usage.Note}" Margin="0,0,4,0">
                            <TextBlock Text="?" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Border Width="1" Height="16" Background="#E2E8F0" Margin="4,0"/>
                        <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionBtn}" Tag="{StaticResource IconMax}"
                                Click="OnToggleMaximize" ToolTip="{DynamicResource Usage.MaxTip}"/>
                        <Button Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}"
                                Click="OnClose" ToolTip="{DynamicResource Usage.CloseTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主内容 -->
            <Grid Grid.Row="1" Margin="16,10,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 整合控制台卡片：页签切换 + 时间区间 + 检索 + 受支持客户端快捷筛选 -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="12,10">
                    <StackPanel>
                        <!-- Row 0: 页签胶囊 + 快捷范围 + 精确起止日期 + 搜索框 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 4 页签胶囊切换 -->
                            <Border Grid.Column="0" Background="#EFF3FA" CornerRadius="8.5" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabProvidersRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabProviders}" Checked="OnTabProvidersChecked" IsChecked="True" Padding="11,4"/>
                                    <RadioButton x:Name="TabAgentsRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabAgents}" Checked="OnTabAgentsChecked" Margin="2,0,0,0" Padding="11,4"/>
                                    <RadioButton x:Name="TabModelsRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabModels}" Checked="OnTabModelsChecked" Margin="2,0,0,0" Padding="11,4"/>
                                    <RadioButton x:Name="TabCallsRadio" Style="{StaticResource SegRadio}" GroupName="UsageViews" Content="{DynamicResource Usage.TabCalls}" Checked="OnTabCallsChecked" Margin="2,0,0,0" Padding="11,4"/>
                                </StackPanel>
                            </Border>

                            <!-- 搜索过滤 + 重置筛选 -->
                            <StackPanel x:Name="TokenFilterStrip" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox" Width="220" Height="30" Padding="10,3" FontSize="12"
                                         Tag="{DynamicResource Usage.SearchPlaceholder}" TextChanged="OnSearchTextChanged"/>
                                <Button x:Name="ClearFilterBtn" Style="{StaticResource ToolbarMiniBtn}" Height="30" Margin="6,0,0,0"
                                        Content="{DynamicResource Usage.ClearFilterBtn}" Click="OnClearFiltersClick" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: 快捷时间范围 + 聚焦单日胶囊 + 自定义日期时间 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EFF3FA" CornerRadius="8" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Quick1DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1D}" Checked="OnQuickRangeChecked" Tag="1"/>
                                        <RadioButton x:Name="Quick7DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1W}" Checked="OnQuickRangeChecked" Tag="7" Margin="2,0,0,0"/>
                                        <RadioButton x:Name="Quick30DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick30D}" Checked="OnQuickRangeChecked" Tag="30" Margin="2,0,0,0"/>
                                        <RadioButton x:Name="Quick180DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick180D}" Checked="OnQuickRangeChecked" Tag="180" Margin="2,0,0,0"/>
                                        <RadioButton x:Name="Quick365DRadio" Style="{StaticResource QuickPillRadio}" GroupName="QuickRange" Content="{DynamicResource Usage.Quick1Y}" Checked="OnQuickRangeChecked" Tag="365" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="FocusedDayChip" Style="{StaticResource ToolbarMiniBtn}" Height="26" Margin="8,0,0,0"
                                        Click="OnClearFocusedDayClick" Visibility="Collapsed"
                                        Background="#EEF2FF" BorderBrush="#C7D2FE" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Usage.From}" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <local:DateTimePickerBox x:Name="StartPicker" Width="148" ValueChanged="OnRangeFieldEdited"/>
                                <TextBlock Text="{DynamicResource Usage.To}" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                <local:DateTimePickerBox x:Name="EndPicker" Width="148" ValueChanged="OnRangeFieldEdited"/>
                                <Button Content="{DynamicResource Usage.Apply}" Style="{StaticResource PrimaryButton}" Padding="14,5" FontSize="12" Margin="8,0,0,0" Click="OnApplyRange"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#F1F5F9" Margin="0,9,0,8"/>

                        <!-- Row 2: 受支持客户端图标快捷筛选按钮行（全部 + 10 客户端） -->
                        <ItemsControl x:Name="ClientFilterList" Margin="0,0,0,-4" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ClientFilterPill}"
                                            Click="OnClientPillClick"
                                            Opacity="{Binding PillOpacity}"
                                            ToolTip="{Binding TooltipText}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding ImageSource}" Width="13" Height="13"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding ImageVisibility}"
                                                   VerticalAlignment="Center"/>
                                            <Path Data="{Binding IconGeometry}" Fill="{Binding IconBrush}"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  Visibility="{Binding PathVisibility}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Margin="5,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Token 核心摘要 + 趋势区 -->
                <StackPanel x:Name="TokenSummarySection" Grid.Row="1" Margin="0,9,0,0">
                    <!-- 5 张平衡微徽章 KPI 卡 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Usage.TotalTokens}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border Width="18" Height="18" CornerRadius="5" Background="#EEF2FF" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TotalTokensText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TotalSubText" Text="—" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource KpiCardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Usage.InputTokens}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border Width="18" Height="18" CornerRadius="5" Background="#E0F2FE" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="InTokensText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#0369A1" Margin="0,4,0,0"/>
                                <TextBlock x:Name="InSubText" Text="—" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource KpiCardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Usage.OutputTokens}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border Width="18" Height="18" CornerRadius="5" Background="#DCFCE7" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="OutTokensText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                                <TextBlock x:Name="OutSubText" Text="—" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource KpiCardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Usage.Requests}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border Width="18" Height="18" CornerRadius="5" Background="#FEF3C7" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="RequestsText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                                <TextBlock x:Name="ReqSubText" Text="—" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="8" Style="{StaticResource KpiCardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Usage.CacheHitRate}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border Width="18" Height="18" CornerRadius="5" Background="#F3E8FF" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="CacheHitText" Text="—" FontSize="21" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                                <TextBlock x:Name="CacheHitDetailText" Text="" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 趋势图 + 客户端多色占比条 -->
                    <Border Margin="0,9,0,0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="14,10,14,8">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Usage.TrendTitle}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <StackPanel x:Name="BarLegendPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#A5B4FC" Margin="14,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Usage.LegendIn}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#4F46E5" Margin="10,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Usage.LegendOut}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel x:Name="HeatmapLegendPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Usage.HeatmapLess}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,4,0" VerticalAlignment="Center"/>
                                        <Border Width="9" Height="9" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Margin="1.5,0"/>
                                        <Border Width="9" Height="9" Background="#C7D2FE" CornerRadius="2" Margin="1.5,0"/>
                                        <Border Width="9" Height="9" Background="#818CF8" CornerRadius="2" Margin="1.5,0"/>
                                        <Border Width="9" Height="9" Background="#6366F1" CornerRadius="2" Margin="1.5,0"/>
