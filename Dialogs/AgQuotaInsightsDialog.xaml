<Window x:Class="APISwitch.Dialogs.AgQuotaInsightsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AgInsight.Title}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1160" Height="760" MinWidth="1020" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FC"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{StaticResource TextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5EAF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
        </Style>

        <Style x:Key="StepperIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="11,4.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountNavBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{Binding CardBg}" BorderBrush="{Binding CardBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="11,9.5">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCellBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{Binding Bg}" BorderBrush="{Binding Border}"
                                BorderThickness="1" CornerRadius="7">
                            <TextBlock Text="{Binding DayText}" FontSize="12" FontWeight="{Binding Weight}"
                                       Foreground="{Binding Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrame" Background="#F6F8FC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== 顶部窗口栏 ==================== -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="16,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1" Margin="0,0,9,0">
                            <Image Source="pack://application:,,,/Assets/antigravity.png" Width="15" Height="15"
                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource AgInsight.Title}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="QuotaSyncTimeText" Text="" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="RefreshQuotaBtn" Style="{StaticResource CardGhostBtn}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                Click="OnRefreshLiveQuotaClick" ToolTip="{DynamicResource AgInsight.RefreshTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}" Fill="#475569" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="RefreshBtnText" Text="{DynamicResource AgInsight.RefreshBtn}" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="15" Background="#E2E8F0" Margin="2,0"/>
                        <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionBtn}" Tag="{StaticResource IconMax}"
                                Click="OnToggleMaximizeClick" ToolTip="{DynamicResource Usage.MaxTip}"/>
                        <Button Style="{StaticResource CaptionCloseBtn}" Tag="{StaticResource IconClose}"
                                Click="OnCloseClick" ToolTip="{DynamicResource Usage.CloseTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 主体左右双栏看板 ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧账号导航栏（直显周余百分比 + 剩余美元估算 + 微进度条） -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,11" Padding="13,14,13,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="3,0,3,10">
                            <TextBlock Text="{DynamicResource Usage.ColAgAccount}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SidebarCountText" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AccountNavList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AccountNavBtn}" Click="OnAccountNavClick">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                                                            Margin="-4,1,7,1" Visibility="{Binding SelectedBarVisibility}"/>

                                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9"
                                                            Background="{Binding AvatarBg}" BorderBrush="{Binding AvatarBorder}" BorderThickness="1"
                                                            VerticalAlignment="Center" Margin="0,0,9,0">
                                                        <TextBlock Text="{Binding Initial}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding AvatarFg}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding ShortName}" FontSize="12.5" FontWeight="{Binding NameWeight}"
                                                                           Foreground="#0F172A" TextTrimming="CharacterEllipsis" MaxWidth="102" VerticalAlignment="Center"/>
                                                                <Border Background="#DCFCE7" CornerRadius="4" Padding="4.5,1" Margin="5,0,0,0"
                                                                        VerticalAlignment="Center" Visibility="{Binding ActiveVisibility}">
                                                                    <TextBlock Text="{DynamicResource Row.StatusCurrent}" FontSize="9" FontWeight="SemiBold" Foreground="#059669"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding WeeklyShortText}" FontSize="11.5" FontWeight="Bold"
                                                                       Foreground="{Binding WeeklyShortBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Grid Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding TierText}" FontSize="10.5" FontWeight="Medium"
                                                                       Foreground="{Binding TierFg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding WeeklyUsdShortText}" FontSize="10.5" FontWeight="Medium"
                                                                       Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                                <!-- 账号周余量微进度条 -->
                                                <Border Height="3" CornerRadius="1.5" Background="#F1F5F9" Margin="0,8,0,0" ClipToBounds="True">
                                                    <Border Width="{Binding MiniBarWidth}" Height="3" CornerRadius="1.5" Background="{Binding WeeklyShortBrush}" HorizontalAlignment="Left"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 左下角：全局官方集体重置快报卡 -->
                        <Button x:Name="MassRadarSideCard" Grid.Row="2" Cursor="Hand" Margin="0,8,0,0" Click="OnJumpToMassTabClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#F8FAFC" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="10" Padding="11,9">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconZap}" Fill="#4F46E5" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{DynamicResource AgInsight.TabMassHistory}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Path Data="{StaticResource IconChevronRight}" Fill="#94A3B8" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="SideMassSummaryText" Text="—" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 右侧主看板 -->
                <Grid Grid.Column="1" Margin="16,13,16,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Band 1: 账号月度订阅总览大卡（身份与结算日 + 4格分隔指标 + 月供给分配比例条） -->
                    <Border Grid.Row="0" Style="{StaticResource WhiteCard}" Padding="16,12">
                        <StackPanel>
                            <!-- 1A. 顶部账号与月周期控制条 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,12,0">
                                    <TextBlock x:Name="HeaderEmailText" Text="—" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <Border x:Name="HeaderTierBadge" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1" CornerRadius="5.5"
                                            Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderTierText" Text="—" FontSize="10.5" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="3,2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PrevMonthBtn" Style="{StaticResource StepperIconBtn}" Click="OnPrevMonthClick" ToolTip="{DynamicResource AgInsight.PrevMonthTip}">
                                                <Path Data="{StaticResource IconChevronRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="9" Height="9" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                                                </Path>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock x:Name="PeriodRangeText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                <Border Background="#FFFFFF" CornerRadius="4.5" Padding="5.5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PeriodTagText" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#4F46E5"/>
                                                </Border>
                                            </StackPanel>
                                            <Button x:Name="NextMonthBtn" Style="{StaticResource StepperIconBtn}" Click="OnNextMonthClick" ToolTip="{DynamicResource AgInsight.NextMonthTip}">
                                                <Path Data="{StaticResource IconChevronRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="9" Height="9" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="CurrentMonthBtn" Style="{StaticResource CardGhostBtn}" Height="30" Padding="9,0" Margin="6,0,0,0"
                                            Content="{DynamicResource AgInsight.BackToCurrentBtn}" Click="OnBackToCurrentMonthClick" Visibility="Collapsed"/>

                                    <Grid Margin="8,0,0,0">
                                        <Button x:Name="BillingDayBtn" Style="{StaticResource CardGhostBtn}" Height="30" Padding="10,0"
                                                Click="OnToggleBillingPopupClick" ToolTip="{DynamicResource AgInsight.BillingNoteTip}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCalendar}" Fill="#64748B" Width="11.5" Height="11.5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="BillingDayBtnText" Text="—" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                                <TextBlock Text="▾" FontSize="10" Foreground="#94A3B8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Popup x:Name="BillingDayPopup" PlacementTarget="{Binding ElementName=BillingDayBtn}" Placement="Bottom"
                                               HorizontalOffset="-165" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="8" Width="288">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="4" Opacity="0.12"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource AgInsight.BillingDayLabel}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{DynamicResource AgInsight.BillingPopupHint}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,9"/>
                                                    <ItemsControl x:Name="DayGridItems">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="7"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource DayCellBtn}" Click="OnPickBillingDayCellClick"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#F1F5F9" Margin="0,11,0,11"/>

                            <!-- 1B. 4 格竖线分隔核心指标带（与 UsageMonitorWindow 视觉完全统一） -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="2,0,12,0">
                                    <TextBlock Text="{DynamicResource AgInsight.KpiActual}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                    <TextBlock x:Name="KpiActualValueText" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#0F766E" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="KpiActualSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#EEF2F7" Margin="0,2"/>

                                <StackPanel Grid.Column="2" Margin="16,0,12,0">
                                    <TextBlock Text="{DynamicResource AgInsight.KpiSupply}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                    <TextBlock x:Name="KpiSupplyValueText" Text="≈ $0.00" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="KpiSupplySubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="3" Background="#EEF2F7" Margin="0,2"/>

                                <StackPanel Grid.Column="4" Margin="16,0,12,0" ToolTip="{DynamicResource AgInsight.WasteFormulaTip}">
                                    <TextBlock Text="{DynamicResource AgInsight.KpiWaste}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                    <TextBlock x:Name="KpiWasteValueText" Text="$0.00" FontSize="22" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="KpiWasteSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="5" Background="#EEF2F7" Margin="0,2"/>

                                <StackPanel Grid.Column="6" Margin="16,0,2,0">
                                    <TextBlock Text="{DynamicResource AgInsight.KpiBonus}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                                    <TextBlock x:Name="KpiBonusValueText" Text="+$0.00" FontSize="22" FontWeight="Bold" Foreground="#4F46E5" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="KpiBonusSubText" Text="—" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1C. Vercel / Cursor 风格：月度额度使用与损耗构成条 -->
                            <Border Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,11,0,0">
                                <StackPanel>
                                    <Border x:Name="AllocTrack" Height="7" CornerRadius="3.5" Background="#E2E8F0" ClipToBounds="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="AllocUsedSeg" Height="7" Background="#0D9488" Width="0"/>
                                            <Border x:Name="AllocWasteSeg" Height="7" Background="#F59E0B" Width="0"/>
                                            <Border x:Name="AllocRemainSeg" Height="7" Background="#CBD5E1" Width="0"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6.5" Height="6.5" Fill="#0D9488" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="AllocUsedLegend" FontSize="11" Foreground="#334155" FontWeight="Medium" Margin="0,0,16,0"/>
                                            <Ellipse Width="6.5" Height="6.5" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="AllocWasteLegend" FontSize="11" Foreground="#475569" Margin="0,0,16,0"/>
                                            <Ellipse Width="6.5" Height="6.5" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="AllocRemainLegend" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Band 2: 对称双模型族配额仪表卡（Cursor 式主读数：剩余可用 / 满额上限 + 百分比徽章） -->
                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左卡：Gemini 模型池 -->
                        <Border Grid.Column="0" Style="{StaticResource WhiteCard}" Padding="16,13">
                            <StackPanel>
                                <Grid Margin="0,0,0,11">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#EEF2FF" Margin="0,0,8,0">
                                            <Path Data="{StaticResource IconGemini}" Fill="#4F46E5" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Ag.GeminiModels}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="GemSourceBadge" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="GemSourceText" Text="—" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>

                                <!-- Gemini 5H -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.FiveHourLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Border Background="#F1F5F9" CornerRadius="4.5" Padding="6,1.5" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="Gem5hResetText" Text="—" FontSize="10.5" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="Gem5hHeadlineUsdText" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Gem5hCapSlashText" FontSize="11" Foreground="#94A3B8" Margin="3,1,7,0" VerticalAlignment="Center"/>
                                        <Border x:Name="Gem5hPctPill" Background="#ECFDF5" CornerRadius="4.5" Padding="5.5,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="Gem5hPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="Gem5hTrack" Height="6" CornerRadius="3" Background="#EEF2F7" Margin="0,6,0,5" ClipToBounds="True">
                                    <Border x:Name="Gem5hFill" Height="6" CornerRadius="3" Background="#059669" HorizontalAlignment="Left" Width="0"/>
                                </Border>
                                <TextBlock x:Name="Gem5hSpentSubText" FontSize="10.5" Foreground="#64748B"/>

                                <Border Height="1" Background="#F1F5F9" Margin="0,10,0,10"/>

                                <!-- Gemini 7D Weekly -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.WeeklyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Border Background="#F1F5F9" CornerRadius="4.5" Padding="6,1.5" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="GemWkResetText" Text="—" FontSize="10.5" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="GemWkHeadlineUsdText" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GemWkCapSlashText" FontSize="11" Foreground="#94A3B8" Margin="3,1,7,0" VerticalAlignment="Center"/>
                                        <Border x:Name="GemWkPctPill" Background="#EEF2FF" CornerRadius="4.5" Padding="5.5,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="GemWkPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#4F46E5"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="GemWkTrack" Height="6" CornerRadius="3" Background="#EEF2F7" Margin="0,6,0,5" ClipToBounds="True">
                                    <Border x:Name="GemWkFill" Height="6" CornerRadius="3" Background="#4F46E5" HorizontalAlignment="Left" Width="0"/>
                                </Border>
                                <TextBlock x:Name="GemWkSpentSubText" FontSize="10.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- 右卡：Claude & GPT 模型池 -->
                        <Border Grid.Column="2" Style="{StaticResource WhiteCard}" Padding="16,13">
                            <StackPanel>
                                <Grid Margin="0,0,0,11">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#F5F3FF" Margin="0,0,8,0">
                                            <Path Data="{StaticResource IconClaude}" Fill="#7C3AED" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Ag.ClaudeGptModels}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="P3SourceBadge" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="P3SourceText" Text="—" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>

                                <!-- Claude/GPT 5H -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.FiveHourLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Border Background="#F1F5F9" CornerRadius="4.5" Padding="6,1.5" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="P35hResetText" Text="—" FontSize="10.5" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="P35hHeadlineUsdText" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="P35hCapSlashText" FontSize="11" Foreground="#94A3B8" Margin="3,1,7,0" VerticalAlignment="Center"/>
                                        <Border x:Name="P35hPctPill" Background="#ECFDF5" CornerRadius="4.5" Padding="5.5,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="P35hPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="P35hTrack" Height="6" CornerRadius="3" Background="#EEF2F7" Margin="0,6,0,5" ClipToBounds="True">
                                    <Border x:Name="P35hFill" Height="6" CornerRadius="3" Background="#059669" HorizontalAlignment="Left" Width="0"/>
                                </Border>
                                <TextBlock x:Name="P35hSpentSubText" FontSize="10.5" Foreground="#64748B"/>

                                <Border Height="1" Background="#F1F5F9" Margin="0,10,0,10"/>

                                <!-- Claude/GPT 7D Weekly -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Ag.WeeklyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Border Background="#F1F5F9" CornerRadius="4.5" Padding="6,1.5" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="P3WkResetText" Text="—" FontSize="10.5" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="P3WkHeadlineUsdText" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="P3WkCapSlashText" FontSize="11" Foreground="#94A3B8" Margin="3,1,7,0" VerticalAlignment="Center"/>
                                        <Border x:Name="P3WkPctPill" Background="#F5F3FF" CornerRadius="4.5" Padding="5.5,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="P3WkPctText" Text="—" FontSize="11" FontWeight="Bold" Foreground="#7C3AED"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="P3WkTrack" Height="6" CornerRadius="3" Background="#EEF2F7" Margin="0,6,0,5" ClipToBounds="True">
                                    <Border x:Name="P3WkFill" Height="6" CornerRadius="3" Background="#7C3AED" HorizontalAlignment="Left" Width="0"/>
                                </Border>
                                <TextBlock x:Name="P3WkSpentSubText" FontSize="10.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Band 3 (*): 三段智能过滤台账（周限周期结算 / 全部重置流水 / 全局集体重置记录） -->
                    <Border Grid.Row="2" Style="{StaticResource WhiteCard}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="14,0">
                                <Grid>
                                    <Border Background="#F1F5F9" CornerRadius="7.5" Padding="2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TabWeeklyHistoryRadio" Style="{StaticResource SegTabRadio}" GroupName="InsightHistTabs"
                                                         Content="{DynamicResource AgInsight.TabWeeklyHistory}" IsChecked="True" Checked="OnHistoryTabChanged"/>
                                            <RadioButton x:Name="TabAcctHistoryRadio" Style="{StaticResource SegTabRadio}" GroupName="InsightHistTabs"
                                                         Content="{DynamicResource AgInsight.TabAccountHistory}" Margin="2,0,0,0" Checked="OnHistoryTabChanged"/>
                                            <RadioButton x:Name="TabMassHistoryRadio" Style="{StaticResource SegTabRadio}" GroupName="InsightHistTabs"
                                                         Content="{DynamicResource AgInsight.TabMassHistory}" Margin="2,0,0,0" Checked="OnHistoryTabChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{DynamicResource AgInsight.HistorySubtitle}" FontSize="11" Foreground="#94A3B8"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 视图 A：本账号重置流水（支持仅看周限结算 vs 全部） -->
                            <Grid x:Name="AccountHistoryPanel" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="31"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="16,0,22,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="166"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource AgInsight.ColHistTime}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource AgInsight.ColPool}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{DynamicResource AgInsight.ColHistType}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{DynamicResource AgInsight.ColHistSpent}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{DynamicResource AgInsight.ColHistImpact}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="EmptyHistoryText" Grid.Row="1" Text="{DynamicResource AgInsight.HistoryEmpty}" FontSize="12"
                                           Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ResetHistoryList" Padding="0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="16,8,22,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="106"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="166"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PoolTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                                        <Border Grid.Column="2" Background="{Binding TypeBadgeBg}" CornerRadius="5" Padding="7,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding TypeTip}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource IconZap}" Fill="{Binding TypeBadgeFg}" Width="9.5" Height="9.5" Stretch="Uniform"
                                                                      Margin="0,0,4,0" Visibility="{Binding ZapVisibility}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding TypeBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding TypeBadgeFg}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock Grid.Column="3" Text="{Binding SpentAndRemText}" FontSize="11.5"
                                                                   Foreground="#475569" VerticalAlignment="Center" TextAlignment="Right"/>

                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0" ClipToBounds="True">
                                                            <TextBlock Text="{Binding ImpactText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding ImpactBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ImpliedCapSuffix}" FontSize="11"
                                                                       Foreground="#94A3B8" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 视图 B：全局官方集体重置记录 -->
                            <Grid x:Name="MassHistoryPanel" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="31"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="16,0,22,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="136"/>
                                            <ColumnDefinition Width="156"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource AgInsight.ColHistTime}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource AgInsight.ColMassScale}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{DynamicResource AgInsight.ColMassRestored}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{DynamicResource AgInsight.ColMassAccounts}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="EmptyMassText" Grid.Row="1" Text="{DynamicResource AgInsight.HistoryEmpty}" FontSize="12"
                                           Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="MassClustersList" Padding="0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="16,8,22,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="136"/>
                                                            <ColumnDefinition Width="156"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="12" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1" CornerRadius="5"
                                                                Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource IconZap}" Fill="#4F46E5" Width="9.5" Height="9.5" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ScaleText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4338CA" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock Grid.Column="2" Text="{Binding RestoredText}" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5" VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="3" Text="{Binding AccountsText}" FontSize="11.5" Foreground="#475569"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountsText}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
